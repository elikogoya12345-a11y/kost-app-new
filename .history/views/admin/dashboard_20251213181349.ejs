<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - KostPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/admin-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Dashboard Admin</h1>
            <p class="text-gray-600 mt-2">Selamat datang, <%= user.name %>!</p>
        </div>

        <!-- Period Filter -->
        <div class="mb-6">
            <div class="bg-white rounded-xl shadow-sm p-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Filter Periode</label>
                <select onchange="window.location.href='/admin/dashboard?period='+this.value" 
                        class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    <option value="week" <%= period === 'week' ? 'selected' : '' %>>Minggu Ini</option>
                    <option value="month" <%= period === 'month' ? 'selected' : '' %>>Bulan Ini</option>
                    <option value="year" <%= period === 'year' ? 'selected' : '' %>>Tahun Ini</option>
                </select>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm">Pendapatan</p>
                        <h3 class="text-xl font-bold">Rp <%= (stats.revenue || 0).toLocaleString('id-ID') %></h3>
                        <p class="text-blue-100 text-xs mt-1">
                            <%= period === 'week' ? 'Minggu ini' : period === 'month' ? 'Bulan ini' : 'Tahun ini' %>
                        </p>
                    </div>
                    <i class="fas fa-money-bill-wave text-2xl text-blue-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">Total Pendapatan</p>
                        <h3 class="text-xl font-bold">Rp <%= (stats.totalRevenue || 0).toLocaleString('id-ID') %></h3>
                        <p class="text-green-100 text-xs mt-1">Semua pembayaran</p>
                    </div>
                    <i class="fas fa-chart-line text-2xl text-green-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-100 text-sm">Pembayaran Pending</p>
                        <h3 class="text-2xl font-bold"><%= stats.pendingPayments || 0 %></h3>
                        <p class="text-yellow-100 text-xs mt-1">Menunggu bayar</p>
                    </div>
                    <i class="fas fa-clock text-2xl text-yellow-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-100 text-sm">Kamar Terisi</p>
                        <h3 class="text-2xl font-bold"><%= stats.occupiedRooms || 0 %></h3>
                        <p class="text-purple-100 text-xs mt-1">dari <%= stats.totalRooms || 0 %> kamar</p>
                    </div>
                    <i class="fas fa-bed text-2xl text-purple-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-red-100 text-sm">Pengaduan</p>
                        <h3 class="text-2xl font-bold"><%= stats.unresolvedComplaints || 0 %></h3>
                        <p class="text-red-100 text-xs mt-1">Belum selesai</p>
                    </div>
                    <i class="fas fa-exclamation-triangle text-2xl text-red-200"></i>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Aksi Cepat</h2>
                <div class="grid grid-cols-2 gap-4">
                    <a href="/admin/occupants" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-users text-2xl text-blue-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Kelola Penghuni</span>
                    </a>
                    <a href="/admin/rooms" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-bed text-2xl text-green-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Kelola Kamar</span>
                    </a>
                    <a href="/admin/payments" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-credit-card text-2xl text-purple-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Kelola Pembayaran</span>
                    </a>
                    <a href="/admin/complaints" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-exclamation-triangle text-2xl text-red-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Pengaduan</span>
                    </a>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Kirim Notifikasi</h2>
                <form action="/admin/notifications" method="POST" class="space-y-4">
                    <input type="hidden" name="user_id" value="all">
                    <input type="hidden" name="type" value="info">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Judul</label>
                        <input type="text" name="title" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                               placeholder="Judul notifikasi">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Pesan</label>
                        <textarea name="message" rows="3" required 
                                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                  placeholder="Isi pesan notifikasi"></textarea>
                    </div>
                    <button type="submit" 
                            class="w-full bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition">
                        <i class="fas fa-bell mr-2"></i>Kirim ke Semua User
                    </button>
                </form>
                <div class="mt-4">
                    <a href="/admin/notifications" class="text-blue-600 hover:text-blue-800 text-sm">
                        <i class="fas fa-cog mr-1"></i>Kelola Notifikasi Lanjutan
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>