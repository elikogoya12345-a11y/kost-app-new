<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Keuangan - Kos Putra Bu Hartini</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
        }
        .title {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .subtitle {
            font-size: 16px;
            color: #666;
            margin-bottom: 10px;
        }
        .period {
            font-size: 14px;
            color: #888;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 12px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f5f5f5;
            font-weight: bold;
        }
        .status-paid {
            color: #22c55e;
            font-weight: bold;
        }
        .status-pending {
            color: #f59e0b;
            font-weight: bold;
        }
        .status-overdue {
            color: #ef4444;
            font-weight: bold;
        }
        .amount {
            font-weight: bold;
            color: #2563eb;
        }
        .user-initial {
            display: inline-block;
            width: 20px;
            height: 20px;
            background-color: #3b82f6;
            color: white;
            text-align: center;
            border-radius: 50%;
            font-size: 10px;
            line-height: 20px;
            margin-right: 5px;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #666;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }
        @media print {
            @page {
                margin: 15mm;
                size: A4;
            }
            body {
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">Kos Putra Bu Hartini</div>
        <div class="subtitle">Laporan Keuangan</div>
        <div class="period">Periode: <%= period %></div>
        <div class="period">Tanggal Cetak: <%= new Date().toLocaleDateString('id-ID') %></div>
    </div>

    <h2>Riwayat Pembayaran</h2>
    
    <table>
        <thead>
            <tr>
                <th>Penghuni</th>
                <th>Kamar</th>
                <th>Periode</th>
                <th>Jumlah</th>
                <th>Jatuh Tempo</th>
                <th>Status</th>
                <th>Metode</th>
            </tr>
        </thead>
        <tbody>
            <% if (payments.length > 0) { %>
                <% payments.forEach(payment => { %>
                    <tr>
                        <td>
                            <span class="user-initial">
                                <%= payment.user_name ? payment.user_name.charAt(0).toUpperCase() : 'U' %>
                            </span>
                            <%= payment.user_name ? payment.user_name.toUpperCase() : 'UNKNOWN USER' %>
                        </td>
                        <td>
                            <% if (payment.room_number) { %>
                                Kamar <%= payment.room_number %>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td><%= payment.month_year %></td>
                        <td class="amount">Rp <%= parseFloat(payment.amount).toLocaleString('id-ID') %></td>
                        <td><%= new Date(payment.due_date).toLocaleDateString('id-ID') %></td>
                        <td>
                            <% if (payment.status === 'paid') { %>
                                <span class="status-paid">Lunas</span>
                            <% } else if (payment.status === 'pending') { %>
                                <span class="status-pending">Pending</span>
                            <% } else if (payment.status === 'overdue') { %>
                                <span class="status-overdue">Terlambat</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (payment.payment_method) { %>
                                <%= payment.payment_method %>
                            <% } else { %>
                                -
                            <% } %>
                            <% if (payment.payment_date && payment.status === 'paid') { %>
                                <br><small><%= new Date(payment.payment_date).toLocaleDateString('id-ID') %></small>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="7" style="text-align: center; padding: 20px;">
                        Tidak ada data pembayaran untuk periode ini
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div class="footer">
        <p>Laporan ini digenerate secara otomatis oleh sistem Kos Putra Bu Hartini</p>
        <p>Lokasi: Beringin Lestari, dekat UMN</p>
    </div>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>