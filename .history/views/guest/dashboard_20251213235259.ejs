<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Dashboard - Kost Putra</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-building text-2xl text-purple-600"></i>
                    <span class="text-xl font-bold text-gray-800">KostPro Guest</span>
                </div>
                
                <div class="flex items-center space-x-4">
                    <a href="/" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                        <i class="fas fa-home mr-2"></i>Kembali ke Menu Utama
                    </a>
                    <a href="/auth/register" class="border border-purple-600 text-purple-600 px-4 py-2 rounded-lg hover:bg-purple-50 transition">
                        <i class="fas fa-user-plus mr-2"></i>Daftar Sekarang
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Welcome Section -->
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-8 text-white mb-8">
            <h1 class="text-3xl font-bold mb-4">Selamat Datang di KostPro</h1>
            <p class="text-purple-100 mb-6">Anda sedang menjelajah sebagai tamu. Daftar sekarang untuk mengakses semua fitur!</p>
            <a href="/auth/register" class="bg-white text-purple-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
                <i class="fas fa-user-plus mr-2"></i>Daftar Gratis
            </a>
        </div>

        <!-- Contact Information -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-sm p-6 text-center">
                <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fab fa-whatsapp text-2xl text-green-600"></i>
                </div>
                <h3 class="text-lg font-semibold mb-2">WhatsApp Admin</h3>
                <p class="text-gray-600 mb-4">+62 812-3456-7890</p>
                <a href="https://wa.me/6281234567890" class="text-green-600 hover:text-green-700 font-medium">
                    Chat Sekarang
                </a>
            </div>

            <div class="bg-white rounded-xl shadow-sm p-6 text-center">
                <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-map-marker-alt text-2xl text-blue-600"></i>
                </div>
                <h3 class="text-lg font-semibold mb-2">Alamat Kost</h3>
                <p class="text-gray-600">Jl. Profesional No. 123<br>Jakarta Selatan 12345</p>
            </div>

            <div class="bg-white rounded-xl shadow-sm p-6 text-center">
                <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-clock text-2xl text-purple-600"></i>
                </div>
                <h3 class="text-lg font-semibold mb-2">Jam Operasional</h3>
                <p class="text-gray-600">Senin - Minggu<br>08:00 - 22:00 WIB</p>
            </div>
        </div>

        <!-- Room Types (Limited View) -->
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Tipe Kamar Tersedia</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% roomTypes.forEach(room => { %>
                    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                        <div class="h-48 bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center">
                            <i class="fas fa-bed text-4xl text-white"></i>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-2"><%= room.name %></h3>
                            <p class="text-gray-600 mb-4"><%= room.description %></p>
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-2xl font-bold text-purple-600">Rp <%= room.base_price.toLocaleString('id-ID') %></span>
                                <span class="text-sm text-gray-500">per bulan</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600"><%= room.available_rooms %> tersedia</span>
                                <button onclick="showRegisterModal()" 
                                        class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                                    Lihat Detail
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- Facilities -->
        <div class="bg-white rounded-xl shadow-sm p-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Fasilitas Umum</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="text-center">
                    <div class="bg-blue-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-wifi text-blue-600"></i>
                    </div>
                    <p class="text-sm text-gray-700">WiFi Cepat</p>
                </div>
                <div class="text-center">
                    <div class="bg-green-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-shield-alt text-green-600"></i>
                    </div>
                    <p class="text-sm text-gray-700">Security 24 Jam</p>
                </div>
                <div class="text-center">
                    <div class="bg-yellow-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-utensils text-yellow-600"></i>
                    </div>
                    <p class="text-sm text-gray-700">Dapur Bersama</p>
                </div>
                <div class="text-center">
                    <div class="bg-purple-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-car text-purple-600"></i>
                    </div>
                    <p class="text-sm text-gray-700">Parkir Luas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div id="registerModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
            <div class="p-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Daftar untuk Melihat Detail</h3>
                <p class="text-gray-600 mb-6">Untuk melihat detail kamar dan melakukan booking, Anda perlu mendaftar terlebih dahulu.</p>
                <div class="space-y-3">
                    <a href="/auth/register" class="block w-full bg-purple-600 text-white text-center py-3 px-4 rounded-lg hover:bg-purple-700 transition">
                        <i class="fas fa-user-plus mr-2"></i>Daftar Sekarang
                    </a>
                    <a href="/auth/login" class="block w-full border border-purple-600 text-purple-600 text-center py-3 px-4 rounded-lg hover:bg-purple-50 transition">
                        <i class="fas fa-sign-in-alt mr-2"></i>Sudah Punya Akun? Login
                    </a>
                </div>
            </div>
            <div class="bg-gray-50 px-6 py-4 rounded-b-lg flex justify-end">
                <button onclick="closeRegisterModal()" class="px-4 py-2 text-gray-600 hover:text-gray-800">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <script>
        function showRegisterModal() {
            document.getElementById('registerModal').classList.remove('hidden');
            document.getElementById('registerModal').classList.add('flex');
        }

        function closeRegisterModal() {
            document.getElementById('registerModal').classList.add('hidden');
            document.getElementById('registerModal').classList.remove('flex');
        }

        document.getElementById('registerModal').addEventListener('click', function(e) {
            if (e.target.id === 'registerModal') {
                closeRegisterModal();
            }
        });
    </script>
</body>
</html>