<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Transaksi Pembayaran - KostPro Admin</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-gray-50">
    <%- include('../partials/admin-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">Kelola Transaksi Pembayaran</h1>
                    <p class="text-gray-600 mt-2">Data transaksi otomatis dari daftar pembayaran</p>
                </div>
                <div class="flex gap-3 no-print">
                    <button onclick="printReport()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium">
                        <i class="fas fa-print mr-2"></i>Cetak Laporan
                    </button>
                    <a href="/admin/payments" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium">
                        <i class="fas fa-arrow-left mr-2"></i>Daftar Pembayaran
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-8 no-print">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Filter & Pencarian</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Dari Tanggal</label>
                    <input type="date" id="startDate" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Sampai Tanggal</label>
                    <input type="date" id="endDate"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select id="statusFilter"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Semua Status</option>
                        <option value="paid">Lunas</option>
                        <option value="pending">Pending</option>
                        <option value="overdue">Terlambat</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Pencarian</label>
                    <input type="text" id="searchInput" placeholder="Nama penghuni atau kamar..."
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            
            <div class="flex gap-3">
                <button onclick="applyFilter()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium">
                    <i class="fas fa-filter mr-2"></i>Terapkan Filter
                </button>
                <button onclick="resetFilter()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium">
                    <i class="fas fa-undo mr-2"></i>Reset
                </button>
            </div>
        </div>

        <div id="printArea">
            <!-- Print Header -->
            <div class="hidden print:block mb-8">
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">Kost Professional</h1>
                    <h2 class="text-xl font-semibold text-gray-700 mb-4">Laporan Transaksi Pembayaran</h2>
                    <p class="text-gray-600" id="printPeriod"></p>
                    <p class="text-sm text-gray-500">Dicetak pada: <span id="printDate"></span></p>
                </div>
            </div>

            <!-- Summary Statistics -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-100 text-sm">Total Lunas</p>
                            <h3 class="text-2xl font-bold" id="totalPaid">0</h3>
                        </div>
                        <i class="fas fa-check-circle text-3xl text-green-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-yellow-100 text-sm">Pending</p>
                            <h3 class="text-2xl font-bold" id="totalPending">0</h3>
                        </div>
                        <i class="fas fa-clock text-3xl text-yellow-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-red-100 text-sm">Terlambat</p>
                            <h3 class="text-2xl font-bold" id="totalOverdue">0</h3>
                        </div>
                        <i class="fas fa-exclamation-triangle text-3xl text-red-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-blue-100 text-sm">Total Pendapatan</p>
                            <h3 class="text-lg font-bold" id="totalRevenue">Rp 0</h3>
                        </div>
                        <i class="fas fa-money-bill-wave text-3xl text-blue-200"></i>
                    </div>
                </div>
            </div>

            <!-- Transactions Table -->
            <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800">Detail Transaksi Pembayaran</h2>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Penghuni</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kamar</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Periode</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jumlah</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jatuh Tempo</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tgl Bayar</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider no-print">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="transactionTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Data will be loaded here -->
                        </tbody>
                    </table>
                </div>
                
                <!-- No Data Message -->
                <div id="noDataMessage" class="hidden px-6 py-12 text-center">
                    <i class="fas fa-search text-4xl text-gray-400 mb-4"></i>
                    <h3 class="text-lg font-semibold text-gray-600 mb-2">Tidak Ada Data</h3>
                    <p class="text-gray-500">Tidak ada transaksi yang sesuai dengan filter yang dipilih</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction Detail Modal -->
    <div id="detailModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50 no-print">
        <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-2xl shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-gray-900">Detail Transaksi</h3>
                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                
                <div id="modalContent">
                    <!-- Content will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        let allTransactions = [];
        let filteredTransactions = [];

        // Load transactions on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadTransactions();
            
            // Set default date range (current month)
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            document.getElementById('startDate').value = firstDay.toISOString().split('T')[0];
            document.getElementById('endDate').value = lastDay.toISOString().split('T')[0];
        });

        async function loadTransactions() {
            try {
                const response = await fetch('/admin/api/payment-transactions');
                const data = await response.json();
                allTransactions = data.transactions || [];
                filteredTransactions = [...allTransactions];
                renderTransactions();
                updateStatistics();
            } catch (error) {
                console.error('Error loading transactions:', error);
                showNoDataMessage();
            }
        }

        function renderTransactions() {
            const tbody = document.getElementById('transactionTableBody');
            const noDataMessage = document.getElementById('noDataMessage');
            
            if (filteredTransactions.length === 0) {
                tbody.innerHTML = '';
                noDataMessage.classList.remove('hidden');
                return;
            }
            
            noDataMessage.classList.add('hidden');
            
            tbody.innerHTML = filteredTransactions.map(transaction => {
                const dueDate = new Date(transaction.due_date);
                const today = new Date();
                const diffTime = dueDate - today;
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                
                return `
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">#PAY-${String(transaction.id).padStart(5, '0')}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">${transaction.user_name}</div>
                        <div class="text-xs text-gray-500">${transaction.user_email || ''}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">Kamar ${transaction.room_number}</div>
                        <div class="text-xs text-gray-500">${transaction.room_type}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${formatMonth(transaction.due_date)}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-gray-900">Rp ${parseFloat(transaction.amount).toLocaleString('id-ID')}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${new Date(transaction.due_date).toLocaleDateString('id-ID')}</div>
                        ${transaction.status === 'pending' && diffDays >= 0 ? 
                            `<div class="text-xs text-blue-600">${diffDays} hari lagi</div>` :
                            transaction.status === 'pending' && diffDays < 0 ?
                            `<div class="text-xs text-red-600">Terlambat ${Math.abs(diffDays)} hari</div>` : ''
                        }
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        ${getStatusBadge(transaction.status)}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">
                            ${transaction.payment_date ? new Date(transaction.payment_date).toLocaleDateString('id-ID') : '-'}
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium no-print">
                        <button onclick="viewTransactionDetail(${transaction.id})" class="text-blue-600 hover:text-blue-900">
                            <i class="fas fa-eye mr-1"></i>Detail
                        </button>
                    </td>
                </tr>
                `;
            }).join('');
        }

        function updateStatistics() {
            const totalPaid = filteredTransactions.filter(t => t.status === 'paid').length;
            const totalPending = filteredTransactions.filter(t => t.status === 'pending').length;
            const totalOverdue = filteredTransactions.filter(t => t.status === 'overdue').length;
            const totalRevenue = filteredTransactions
                .filter(t => t.status === 'paid')
                .reduce((sum, t) => sum + parseFloat(t.amount), 0);

            document.getElementById('totalPaid').textContent = totalPaid;
            document.getElementById('totalPending').textContent = totalPending;
            document.getElementById('totalOverdue').textContent = totalOverdue;
            document.getElementById('totalRevenue').textContent = `Rp ${totalRevenue.toLocaleString('id-ID')}`;
        }

        function applyFilter() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const status = document.getElementById('statusFilter').value;
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();

            filteredTransactions = allTransactions.filter(transaction => {
                let matches = true;

                if (startDate) {
                    matches = matches && new Date(transaction.due_date) >= new Date(startDate);
                }
                if (endDate) {
                    matches = matches && new Date(transaction.due_date) <= new Date(endDate);
                }
                if (status) {
                    matches = matches && transaction.status === status;
                }
                if (searchTerm) {
                    matches = matches && (
                        transaction.user_name.toLowerCase().includes(searchTerm) ||
                        transaction.room_number.toLowerCase().includes(searchTerm) ||
                        transaction.room_type.toLowerCase().includes(searchTerm)
                    );
                }

                return matches;
            });

            renderTransactions();
            updateStatistics();
        }

        function resetFilter() {
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('searchInput').value = '';
            
            // Reset to current month
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            document.getElementById('startDate').value = firstDay.toISOString().split('T')[0];
            document.getElementById('endDate').value = lastDay.toISOString().split('T')[0];
            
            filteredTransactions = [...allTransactions];
            renderTransactions();
            updateStatistics();
        }

        async function viewTransactionDetail(id) {
            try {
                const response = await fetch(`/admin/api/payment-transactions/${id}`);
                const data = await response.json();
                const transaction = data.transaction;

                document.getElementById('modalContent').innerHTML = `
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700">ID Transaksi</label>
                                <p class="text-lg font-bold text-gray-900">#PAY-${String(transaction.id).padStart(5, '0')}</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Status</label>
                                ${getStatusBadge(transaction.status)}
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Penghuni</label>
                                <p class="font-medium text-gray-900">${transaction.user_name}</p>
                                <p class="text-sm text-gray-500">${transaction.user_email || ''}</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Kamar</label>
                                <p class="font-medium text-gray-900">Kamar ${transaction.room_number}</p>
                                <p class="text-sm text-gray-500">${transaction.room_type}</p>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Periode</label>
                                <p class="font-medium text-gray-900">${formatMonth(transaction.due_date)}</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Jumlah</label>
                                <p class="text-lg font-bold text-blue-600">Rp ${parseFloat(transaction.amount).toLocaleString('id-ID')}</p>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Jatuh Tempo</label>
                                <p class="font-medium text-gray-900">${new Date(transaction.due_date).toLocaleDateString('id-ID')}</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Tanggal Bayar</label>
                                <p class="font-medium text-gray-900">
                                    ${transaction.payment_date ? new Date(transaction.payment_date).toLocaleDateString('id-ID') : 'Belum dibayar'}
                                </p>
                            </div>
                        </div>
                        
                        ${transaction.notes ? `
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Catatan</label>
                                <p class="text-gray-900">${transaction.notes}</p>
                            </div>
                        ` : ''}
                    </div>
                `;

                document.getElementById('detailModal').classList.remove('hidden');
            } catch (error) {
                console.error('Error loading transaction detail:', error);
                alert('Gagal memuat detail transaksi');
            }
        }

        function closeModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function printReport() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            let period = 'Semua Periode';
            if (startDate && endDate) {
                period = `${new Date(startDate).toLocaleDateString('id-ID')} - ${new Date(endDate).toLocaleDateString('id-ID')}`;
            } else if (startDate) {
                period = `Mulai ${new Date(startDate).toLocaleDateString('id-ID')}`;
            } else if (endDate) {
                period = `Sampai ${new Date(endDate).toLocaleDateString('id-ID')}`;
            }
            
            document.getElementById('printPeriod').textContent = `Periode: ${period}`;
            document.getElementById('printDate').textContent = new Date().toLocaleDateString('id-ID', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            
            window.print();
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'paid':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800"><i class="fas fa-check mr-1"></i>Lunas</span>';
                case 'pending':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800"><i class="fas fa-clock mr-1"></i>Pending</span>';
                case 'overdue':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800"><i class="fas fa-exclamation-triangle mr-1"></i>Terlambat</span>';
                default:
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Unknown</span>';
            }
        }

        function formatMonth(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('id-ID', {
                year: 'numeric',
                month: 'long'
            });
        }

        function showNoDataMessage() {
            document.getElementById('transactionTableBody').innerHTML = '';
            document.getElementById('noDataMessage').classList.remove('hidden');
        }

        // Enter key search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                applyFilter();
            }
        });
    </script>
</body>
</html>