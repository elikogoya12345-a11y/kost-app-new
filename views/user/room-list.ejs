<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Kamar - KostPro User</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="user-bg">
    <style>
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-gold-light {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
        }
        .glossy-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
    </style>
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gold-dark">
                            <% if (roomType) { %>
                                <%= roomType.name %>
                            <% } else { %>
                                Daftar Kamar
                            <% } %>
                        </h1>
                        <p class="text-gold mt-2">
                            <% if (roomType) { %>
                                Kamar tersedia untuk tipe <%= roomType.name %>
                            <% } else { %>
                                Lihat semua kamar yang tersedia
                            <% } %>
                        </p>
                    </div>
                    <a href="/user/rooms" class="glossy-gold-light text-gold-dark px-4 py-2 rounded-lg hover:opacity-90 transition-opacity">
                        <i class="fas fa-arrow-left mr-2"></i>Kembali
                    </a>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% rooms.forEach(room => { %>
                <div class="glossy-white rounded-2xl overflow-hidden glossy-card">
                    <div class="relative h-48 overflow-hidden">
                        <% 
                            let roomImageUrl;
                            switch(room.type_name) {
                                case 'Standard Room': roomImageUrl = 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop'; break;
                                case 'Superior Room': roomImageUrl = 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop'; break;
                                case 'Deluxe Room': roomImageUrl = 'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=400&fit=crop'; break;
                                case 'Suite Room': roomImageUrl = 'https://images.unsplash.com/photo-1571508601891-ca5e7a713859?w=600&h=400&fit=crop'; break;
                                case 'Share Room': roomImageUrl = 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&h=400&fit=crop'; break;
                                case 'Large Room': roomImageUrl = 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=600&h=400&fit=crop'; break;
                                case 'President Room': roomImageUrl = 'https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=600&h=400&fit=crop'; break;
                                default: roomImageUrl = 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop';
                            }
                        %>
                        <img src="<%= room.type_image_url || roomImageUrl %>" alt="Kamar <%= room.room_number %>" 
                             class="w-full h-full object-cover">
                        <div class="absolute top-4 left-4">
                            <span class="glossy-gold text-white px-3 py-1 rounded-full text-sm font-semibold">
                                Kamar <%= room.room_number %>
                            </span>
                        </div>
                        <div class="absolute top-4 right-4">
                            <span class="<%= room.status === 'available' ? 'bg-green-500' : 'bg-red-500' %> text-white px-3 py-1 rounded-full text-sm font-semibold">
                                <%= room.status === 'available' ? 'Tersedia' : 'Terisi' %>
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-bold text-gold-dark">Kamar <%= room.room_number %></h3>
                            <span class="text-sm text-gold"><%= room.type_name %></span>
                        </div>
                        
                        <div class="flex items-center justify-between mb-4">
                            <div class="text-2xl font-bold text-amber-600">
                                Rp <%= parseInt(room.base_price).toLocaleString('id-ID') %>
                            </div>
                            <div class="text-sm text-gold">per bulan</div>
                        </div>
                        
                        <div class="flex gap-2">
                            <% if (room.status === 'available') { %>
                                <a href="/user/bookings?room=<%= room.id %>" 
                                   class="flex-1 glossy-gold text-white px-4 py-2 rounded-lg text-center hover:opacity-90 transition-opacity"
                                   onclick="return handleRoomBooking('<%= room.id %>', '<%= room.room_number %>', '<%= room.type_name %>', '<%= room.base_price %>', '<%= room.room_type_id || room.type_id %>')">
                                    <i class="fas fa-calendar-plus mr-2"></i>Booking Sekarang
                                </a>
                            <% } else { %>
                                <button disabled 
                                        class="flex-1 bg-gray-400 text-white px-4 py-2 rounded-lg cursor-not-allowed text-center">
                                    <i class="fas fa-times mr-2"></i>Tidak Tersedia
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <% if (rooms.length === 0) { %>
            <div class="glossy-white rounded-2xl p-8 text-center glossy-card">
                <i class="fas fa-bed text-6xl text-amber-300 mb-4"></i>
                <h3 class="text-xl font-bold text-gold-dark mb-2">Tidak Ada Kamar Tersedia</h3>
                <p class="text-gold">
                    <% if (roomType) { %>
                        Saat ini tidak ada kamar tersedia untuk tipe <%= roomType.name %>.
                    <% } else { %>
                        Saat ini tidak ada kamar yang tersedia.
                    <% } %>
                </p>
            </div>
        <% } %>
    </div>

    <script>
        function handleRoomBooking(roomId, roomNumber, typeName, price, roomTypeId) {
            const isBookingMode = new URLSearchParams(window.location.search).has('booking');
            
            if (isBookingMode) {
                // Add room to existing booking
                const savedBooking = sessionStorage.getItem('currentBooking');
                let bookingData = savedBooking ? JSON.parse(savedBooking) : { selected_rooms: [] };
                
                // Check if room already selected
                const existing = bookingData.selected_rooms.find(r => r.room_id === roomId);
                if (existing) {
                    alert('Kamar sudah dipilih sebelumnya!');
                    return false;
                }
                
                // Add new room
                bookingData.selected_rooms.push({
                    room_id: roomId,
                    room_number: roomNumber,
                    type_name: typeName,
                    price: price,
                    room_type_id: roomTypeId
                });
                
                sessionStorage.setItem('currentBooking', JSON.stringify(bookingData));
                window.location.href = '/user/bookings';
                return false;
            }
            
            return true;
        }
        
        // Show booking mode indicator
        const isBookingMode = new URLSearchParams(window.location.search).has('booking');
        if (isBookingMode) {
            const savedBooking = sessionStorage.getItem('currentBooking');
            const bookingData = savedBooking ? JSON.parse(savedBooking) : { selected_rooms: [] };
            const selectedRoomIds = bookingData.selected_rooms.map(r => r.room_id);
            
            // Mark already selected rooms
            document.querySelectorAll('.glossy-card').forEach(card => {
                const link = card.querySelector('a[href*="bookings?room="]');
                if (link) {
                    const roomId = link.href.split('room=')[1];
                    if (selectedRoomIds.includes(roomId)) {
                        const button = card.querySelector('a');
                        button.classList.remove('glossy-gold');
                        button.classList.add('bg-orange-500');
                        button.innerHTML = '<i class="fas fa-clock mr-2"></i>Dalam Proses Booking';
                        button.onclick = () => { alert('Kamar sudah dalam proses booking!'); return false; };
                    }
                }
            });
        }
    </script>
</body>
</html>