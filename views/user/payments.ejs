<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembayaran - KostPro User</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="user-bg">
    <style>
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-gold-light {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
        }
        .glossy-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
    </style>
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h1 class="text-3xl font-bold text-gold-dark">Riwayat Pembayaran</h1>
                <p class="text-gold mt-2">Kelola dan pantau pembayaran kost Anda</p>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="glossy-gold-light border border-amber-200 text-green-700 px-4 py-3 rounded-xl mb-6 glossy-card">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>

        <!-- Payment Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="glossy-gold rounded-2xl p-6 text-white glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-amber-100 text-sm">Total Dibayar</p>
                        <h3 class="text-2xl font-bold">
                            Rp <%= (payments && payments.length > 0) ? payments.filter(p => p.status === 'paid').reduce((sum, p) => sum + parseFloat(p.amount || 0), 0).toLocaleString('id-ID') : '0' %>
                        </h3>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-check-circle text-2xl text-green-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-gold-light rounded-2xl p-6 text-gold-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gold text-sm">Menunggu Pembayaran</p>
                        <h3 class="text-2xl font-bold">
                            <%= (payments && payments.length > 0) ? payments.filter(p => p.status === 'pending').length : 0 %>
                        </h3>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-clock text-2xl text-amber-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 text-gold-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gold text-sm">Terlambat</p>
                        <h3 class="text-2xl font-bold">
                            <%= (payments && payments.length > 0) ? payments.filter(p => p.status === 'overdue').length : 0 %>
                        </h3>
                    </div>
                    <div class="glossy-gold-light p-3 rounded-xl glossy-card">
                        <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment List -->
        <div class="glossy-white rounded-2xl overflow-hidden glossy-card">
            <div class="p-6 border-b border-amber-200 flex justify-between items-center">
                <h2 class="text-xl font-bold text-gold-dark">Daftar Pembayaran</h2>
                <% if (payments && payments.length > 0) { %>
                    <button onclick="exportToPDF()" class="glossy-gold text-white px-4 py-2 rounded-lg glossy-card">
                        <i class="fas fa-file-pdf mr-2"></i>Export PDF
                    </button>
                <% } %>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="glossy-gold-light">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gold uppercase tracking-wider">Periode</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gold uppercase tracking-wider">Jumlah</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gold uppercase tracking-wider">Jatuh Tempo</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gold uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gold uppercase tracking-wider">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="glossy-white divide-y divide-amber-200">
                        <% if (payments && payments.length > 0) { %>
                            <% payments.forEach(payment => { 
                                const dueDate = new Date(payment.due_date);
                                const today = new Date();
                                const diffTime = dueDate - today;
                                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                            %>
                                <tr class="hover:bg-amber-50" data-payment-id="<%= payment.id %>">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gold-dark"><%= payment.month_year || 'N/A' %></div>
                                        <div class="text-xs text-gold">Kamar <%= payment.room_number %> - <%= payment.room_type %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-bold text-amber-600">Rp <%= parseFloat(payment.amount).toLocaleString('id-ID') %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gold-dark">
                                            <%= new Date(payment.due_date).toLocaleDateString('id-ID') %>
                                        </div>
                                        <% if (payment.status === 'pending' && diffDays >= 0) { %>
                                            <div class="text-xs text-amber-600">
                                                <%= diffDays %> hari lagi
                                            </div>
                                        <% } else if (payment.status === 'pending' && diffDays < 0) { %>
                                            <div class="text-xs text-red-600">
                                                Terlambat <%= Math.abs(diffDays) %> hari
                                            </div>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <% if (payment.status === 'paid') { %>
                                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 payment-status">
                                                <i class="fas fa-check mr-1"></i>Lunas
                                            </span>
                                        <% } else if (payment.status === 'pending') { %>
                                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 payment-status">
                                                <i class="fas fa-clock mr-1"></i>Pending
                                            </span>
                                        <% } else if (payment.status === 'overdue') { %>
                                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 payment-status">
                                                <i class="fas fa-exclamation-triangle mr-1"></i>Terlambat
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <% if (payment.status === 'pending' || payment.status === 'overdue') { %>
                                            <div class="text-center">
                                                <div class="text-xs text-gold mb-2">Sudah bayar? Tekan disini:</div>
                                                <button data-payment-id="<%= payment.id %>"
                                                        class="glossy-gold text-white px-4 py-2 rounded-lg glossy-card text-sm font-medium payment-confirm-btn">
                                                    <i class="fas fa-check mr-2"></i>Konfirmasi Pembayaran
                                                </button>
                                            </div>
                                        <% } %>
                                        <% if (payment.status === 'paid' && payment.payment_date) { %>
                                            <div class="text-center">
                                                <span class="text-green-600 text-sm payment-date">
                                                    <i class="fas fa-calendar-check mr-1"></i>
                                                    Dibayar: <%= new Date(payment.payment_date).toLocaleDateString('id-ID') %>
                                                </span>
                                            </div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <i class="fas fa-receipt text-4xl text-gold mb-4"></i>
                                    <h3 class="text-lg font-semibold text-gold-dark mb-2">Belum Ada Pembayaran</h3>
                                    <p class="text-gold">Riwayat pembayaran akan muncul di sini</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Auto-hide success message
        document.addEventListener('DOMContentLoaded', function() {
            <% if (typeof success !== 'undefined' && success) { %>
                setTimeout(() => {
                    const alert = document.querySelector('.glossy-gold-light');
                    if (alert) alert.remove();
                }, 5000);
            <% } %>
            
            // Add event listeners to payment confirmation buttons
            document.querySelectorAll('.payment-confirm-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const paymentId = this.getAttribute('data-payment-id');
                    confirmPaymentRealtime(paymentId);
                });
            });
        });
        
        function exportToPDF() {
            // Create a new window for PDF content
            const printWindow = window.open('', '_blank');
            const currentDate = new Date().toLocaleDateString('id-ID');
            
            // Get payment data from the current page
            const payments = [];
            const paymentRows = document.querySelectorAll('tbody tr[data-payment-id]');
            
            paymentRows.forEach((row, index) => {
                const cells = row.querySelectorAll('td');
                if (cells.length >= 4) {
                    payments.push({
                        no: index + 1,
                        periode: cells[0].querySelector('.text-sm').textContent,
                        kamar: cells[0].querySelector('.text-xs').textContent,
                        jumlah: cells[1].querySelector('.text-sm').textContent,
                        jatuhTempo: cells[2].querySelector('.text-sm').textContent,
                        status: cells[3].querySelector('span').textContent.trim(),
                        tanggalBayar: cells[4].querySelector('.payment-date') ? 
                                     cells[4].querySelector('.payment-date').textContent.replace('Dibayar: ', '') : '-'
                    });
                }
            });
            
            const pdfContent = `
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Laporan Pembayaran Kost</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; }
                        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 20px; }
                        .info { margin-bottom: 20px; }
                        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
                        th { background-color: #f2f2f2; font-weight: bold; }
                        .status-paid { color: green; font-weight: bold; }
                        .status-pending { color: orange; font-weight: bold; }
                        .status-overdue { color: red; font-weight: bold; }
                        .total { font-weight: bold; background-color: #f9f9f9; }
                        @media print { body { margin: 0; } }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <h1>LAPORAN PEMBAYARAN KOST</h1>
                        <h2>Kost Putra Bu Hartini</h2>
                        <p>Tanggal Cetak: ${currentDate}</p>
                    </div>
                    
                    <table>
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Periode</th>
                                <th>Kamar</th>
                                <th>Jumlah</th>
                                <th>Jatuh Tempo</th>
                                <th>Status</th>
                                <th>Tanggal Bayar</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${payments.map(payment => `
                                <tr>
                                    <td>${payment.no}</td>
                                    <td>${payment.periode}</td>
                                    <td>${payment.kamar}</td>
                                    <td>${payment.jumlah}</td>
                                    <td>${payment.jatuhTempo}</td>
                                    <td>${payment.status}</td>
                                    <td>${payment.tanggalBayar}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 30px; text-align: center; font-size: 12px; color: #666;">
                        <p>Dokumen ini dicetak secara otomatis dari sistem Kost Putra Bu Hartini</p>
                        <p>Untuk pertanyaan, hubungi pengelola kost</p>
                    </div>
                </body>
                </html>
            `;
            
            printWindow.document.write(pdfContent);
            printWindow.document.close();
            
            // Wait for content to load then print
            printWindow.onload = function() {
                printWindow.print();
            };
        }
        
        // Real-time payment confirmation
        function confirmPaymentRealtime(paymentId) {
            const button = document.querySelector(`[data-payment-id="${paymentId}"]`);
            const originalButtonText = button ? button.innerHTML : '';
            
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Memproses...';
            }
            
            // Use traditional fetch since realtime client might not be available
            fetch(`/user/payments/${paymentId}/confirm`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Show success message
                    showSuccessMessage('Pembayaran berhasil dikonfirmasi!');
                    
                    // Update UI immediately
                    updatePaymentStatus(paymentId, 'paid');
                    
                    // Refresh page after 2 seconds to show updated data
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showErrorMessage(data.message || 'Gagal mengkonfirmasi pembayaran');
                    // Reset button
                    if (button) {
                        button.disabled = false;
                        button.innerHTML = originalButtonText;
                    }
                }
            })
            .catch(error => {
                console.error('Payment confirmation error:', error);
                showErrorMessage('Terjadi kesalahan saat memproses pembayaran');
                // Reset button
                if (button) {
                    button.disabled = false;
                    button.innerHTML = originalButtonText;
                }
            });
        }
        
        function updatePaymentStatus(paymentId, status) {
            const row = document.querySelector(`tr[data-payment-id="${paymentId}"]`);
            if (row) {
                const statusElement = row.querySelector('.payment-status');
                const actionCell = row.querySelector('td:last-child');
                
                if (statusElement && status === 'paid') {
                    statusElement.className = 'inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 payment-status';
                    statusElement.innerHTML = '<i class="fas fa-check mr-1"></i>Lunas';
                }
                
                if (actionCell && status === 'paid') {
                    actionCell.innerHTML = `
                        <div class="text-center">
                            <span class="text-green-600 text-sm payment-date">
                                <i class="fas fa-calendar-check mr-1"></i>
                                Dibayar: ${new Date().toLocaleDateString('id-ID')}
                            </span>
                        </div>
                    `;
                }
            }
        }
        
        function showSuccessMessage(message) {
            // Create success notification
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 glossy-card';
            notification.innerHTML = `
                <div class="flex items-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span>${message}</span>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Remove after 3 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 3000);
        }
        
        function showErrorMessage(message) {
            // Create error notification
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 glossy-card';
            notification.innerHTML = `
                <div class="flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span>${message}</span>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Remove after 5 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 5000);
        }
        
        function refreshPaymentSummary() {
            // Refresh the summary cards by reloading page data
            location.reload();
        }
        
        function showNotification(title, message, type) {
            if (type === 'success') {
                showSuccessMessage(message);
            } else {
                showErrorMessage(message);
            }
        }
        
        // Auto-refresh payment status every 60 seconds
        setInterval(() => {
            if (window.realtimeClient && window.realtimeClient.isConnected) {
                window.realtimeClient.refreshPaymentStats();
            }
        }, 60000);
    </script>
</body>
</html>