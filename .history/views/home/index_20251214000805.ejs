<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kos Putra Bu Hartini - Tempat Tinggal Nyaman Dekat UMN</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-home text-2xl text-blue-600"></i>
                    <span class="text-xl font-bold text-gray-800">Kos Putra Bu Hartini</span>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <!-- User sudah login -->
                        <% if (user.role === 'admin') { %>
                            <a href="/admin/dashboard" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard Admin
                            </a>
                        <% } else { %>
                            <a href="/user/dashboard" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard User
                            </a>
                        <% } %>
                        <div class="flex items-center space-x-2 text-gray-600">
                            <i class="fas fa-user-circle"></i>
                            <span>Halo, <%= user.name %>!</span>
                        </div>
                        <a href="/auth/logout" class="text-gray-600 hover:text-red-600 transition">
                            <i class="fas fa-sign-out-alt mr-2"></i>Logout
                        </a>
                    <% } else { %>
                        <!-- User belum login -->
                        <a href="/auth/login" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-sign-in-alt mr-2"></i>Login
                        </a>
                        <a href="/auth/register" class="border border-blue-600 text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition">
                            <i class="fas fa-user-plus mr-2"></i>Daftar
                        </a>
                        <a href="/about" class="text-gray-600 hover:text-blue-600 transition">
                            <i class="fas fa-info-circle mr-2"></i>Tentang Kami
                        </a>
                        <a href="/guest/dashboard" class="text-gray-600 hover:text-blue-600 transition">
                            <i class="fas fa-eye mr-2"></i>Masuk Sebagai Tamu
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-purple-600 text-white py-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <% if (user) { %>
                <!-- Hero untuk user yang sudah login -->
                <h1 class="text-5xl font-bold mb-6">Selamat Datang Kembali!</h1>
                <p class="text-xl mb-8 opacity-90">Halo <%= user.name %>, akses dashboard Anda untuk mengelola kost</p>
                <div class="flex justify-center space-x-4">
                    <% if (user.role === 'admin') { %>
                        <a href="/admin/dashboard" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
                            <i class="fas fa-tachometer-alt mr-2"></i>Dashboard Admin
                        </a>
                        <a href="/admin/occupants" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition">
                            <i class="fas fa-users mr-2"></i>Kelola Penghuni
                        </a>
                    <% } else { %>
                        <a href="/user/dashboard" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
                            <i class="fas fa-tachometer-alt mr-2"></i>Dashboard User
                        </a>
                        <a href="/user/rooms" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition">
                            <i class="fas fa-bed mr-2"></i>Lihat Kamar
                        </a>
                    <% } %>
                </div>
            <% } else { %>
                <!-- Hero untuk guest -->
                <h1 class="text-5xl font-bold mb-6">Kos Putra Bu Hartini</h1>
                <p class="text-xl mb-8 opacity-90">Tempat tinggal nyaman dekat UMN dengan fasilitas lengkap dan harga terjangkau</p>
                <div class="flex justify-center space-x-4">
                    <a href="/auth/register" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
                        Mulai Sekarang
                    </a>
                    <a href="#facilities" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition">
                        Lihat Fasilitas
                    </a>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Quick Access untuk User yang Login -->
    <% if (user) { %>
    <section class="py-12 bg-gray-100">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Akses Cepat</h2>
                <p class="text-gray-600">Navigasi cepat ke fitur utama</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <% if (user.role === 'admin') { %>
                    <a href="/admin/dashboard" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-chart-line text-3xl text-blue-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Dashboard</h3>
                        <p class="text-sm text-gray-600">Statistik & Laporan</p>
                    </a>
                    <a href="/admin/occupants" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-users text-3xl text-green-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Penghuni</h3>
                        <p class="text-sm text-gray-600">Kelola Penghuni</p>
                    </a>
                    <a href="/admin/rooms" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-bed text-3xl text-purple-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Kamar</h3>
                        <p class="text-sm text-gray-600">Kelola Kamar</p>
                    </a>
                    <a href="/admin/complaints" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-exclamation-triangle text-3xl text-red-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Pengaduan</h3>
                        <p class="text-sm text-gray-600">Tangani Keluhan</p>
                    </a>
                <% } else { %>
                    <a href="/user/dashboard" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-tachometer-alt text-3xl text-blue-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Dashboard</h3>
                        <p class="text-sm text-gray-600">Panel Utama</p>
                    </a>
                    <a href="/user/rooms" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-bed text-3xl text-green-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Kamar</h3>
                        <p class="text-sm text-gray-600">Lihat & Booking</p>
                    </a>
                    <a href="/user/payments" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-credit-card text-3xl text-purple-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Pembayaran</h3>
                        <p class="text-sm text-gray-600">Riwayat Bayar</p>
                    </a>
                    <a href="/user/complaints" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition text-center">
                        <i class="fas fa-exclamation-triangle text-3xl text-red-600 mb-3"></i>
                        <h3 class="font-semibold text-gray-800">Pengaduan</h3>
                        <p class="text-sm text-gray-600">Laporkan Masalah</p>
                    </a>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Room Types Preview -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Tipe Kamar Tersedia</h2>
                <p class="text-gray-600">Pilih kamar yang sesuai dengan kebutuhan dan budget Anda</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% roomTypes.forEach(room => { %>
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">
                        <div class="h-48 bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center">
                            <i class="fas fa-bed text-4xl text-white"></i>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-2"><%= room.name %></h3>
                            <p class="text-gray-600 mb-4"><%= room.description %></p>
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-2xl font-bold text-blue-600">Rp <%= room.base_price.toLocaleString('id-ID') %></span>
                                <span class="text-sm text-gray-500">per bulan</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600"><%= room.available_rooms %> tersedia</span>
                                <a href="/auth/register" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                                    Lihat Detail
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Facilities -->
    <section id="facilities" class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Fasilitas Kos Putra Bu Hartini</h2>
                <p class="text-gray-600">Fasilitas lengkap untuk kenyamanan penghuni</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="text-center">
                    <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-wifi text-2xl text-blue-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">WiFi Lancar</h3>
                    <p class="text-gray-600">Akses internet untuk belajar dan bekerja</p>
                </div>
                <div class="text-center">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-bath text-2xl text-green-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">10 Kamar Mandi</h3>
                    <p class="text-gray-600">Kamar mandi luar yang bersih setiap hari</p>
                </div>
                <div class="text-center">
                    <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-motorcycle text-2xl text-purple-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Parkir Motor</h3>
                    <p class="text-gray-600">Area parkir untuk 30 motor</p>
                </div>
                <div class="text-center">
                    <div class="bg-yellow-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-utensils text-2xl text-yellow-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Dapur Bersama</h3>
                    <p class="text-gray-600">Kompor, gas, dan kulkas 2 pintu</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Hubungi Kami</h2>
                <p class="text-gray-600">Siap membantu Anda 24/7</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fab fa-whatsapp text-2xl text-green-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">WhatsApp</h3>
                    <p class="text-gray-600 mb-4">+62 812-3456-7890</p>
                    <a href="https://wa.me/6281234567890" class="text-green-600 hover:text-green-700">Chat Sekarang</a>
                </div>
                <div class="text-center">
                    <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-map-marker-alt text-2xl text-blue-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Lokasi</h3>
                    <p class="text-gray-600">Beringin Lestari<br>Dekat Universitas Multimedia Nusantara</p>
                </div>
                <div class="text-center">
                    <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-clock text-2xl text-purple-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Jam Operasional</h3>
                    <p class="text-gray-600">Senin - Minggu<br>08:00 - 22:00 WIB</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <div class="flex items-center justify-center space-x-2 mb-4">
                <i class="fas fa-home text-2xl text-blue-400"></i>
                <span class="text-xl font-bold">Kos Putra Bu Hartini</span>
            </div>
            <p class="text-gray-400">© 2024 Kos Putra Bu Hartini. Tempat tinggal nyaman dekat UMN.</p>
        </div>
    </footer>
</body>
</html>