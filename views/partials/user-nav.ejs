<style>
/* USER THEME: Gold Glossy Dominant with Blue Accents */
.glossy-gold {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
    backdrop-filter: blur(20px);
    box-shadow: 0 12px 40px rgba(251, 191, 36, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
}
.glossy-gold-light {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
    backdrop-filter: blur(15px);
    box-shadow: 0 8px 25px rgba(251, 191, 36, 0.3);
    border: 1px solid rgba(251, 191, 36, 0.2);
}
.glossy-blue {
    background: linear-gradient(135deg, #3b82f6 0%, #1e40af 50%, #1d4ed8 100%);
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 35px rgba(59, 130, 246, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
}
.glossy-white {
    background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f8fafc 100%);
    backdrop-filter: blur(15px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.6);
}
.glossy-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 16px;
}
.glossy-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 10px 20px rgba(0, 0, 0, 0.1);
}
.user-bg {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
    min-height: 100vh;
}
.text-gold {
    color: #92400e;
}
.text-gold-dark {
    color: #78350f;
}
.text-blue-medium {
    color: #1d4ed8;
}
</style>

<nav class="glossy-gold sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center h-16">
            <div class="flex items-center space-x-3">
                <div class="glossy-white p-2 rounded-xl glossy-card">
                    <i class="fas fa-user text-xl text-blue-600"></i>
                </div>
                <span class="text-xl font-bold text-white">Kost Putra Bu Hartini</span>
            </div>
            
            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center space-x-1">
                <a href="/user/dashboard" class="text-white hover:bg-white hover:bg-opacity-25 px-4 py-2 rounded-xl transition glossy-card font-medium">
                    <i class="fas fa-tachometer-alt mr-2"></i>Dashboard
                </a>
                <a href="/user/rooms" class="text-white hover:bg-white hover:bg-opacity-25 px-4 py-2 rounded-xl transition glossy-card font-medium">
                    <i class="fas fa-bed mr-2"></i>Kamar
                </a>
                <a href="/user/bookings" class="text-white hover:bg-white hover:bg-opacity-25 px-4 py-2 rounded-xl transition glossy-card font-medium">
                    <i class="fas fa-calendar-check mr-2"></i>Booking
                </a>
                <a href="/user/payments" class="text-white hover:bg-white hover:bg-opacity-25 px-4 py-2 rounded-xl transition glossy-card font-medium">
                    <i class="fas fa-credit-card mr-2"></i>Pembayaran
                </a>
                <a href="/user/complaints" class="text-white hover:bg-white hover:bg-opacity-25 px-4 py-2 rounded-xl transition glossy-card font-medium">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Pengaduan
                </a>
            </div>

            <div class="flex items-center space-x-3">
                <a href="/" class="hidden md:block glossy-white text-blue-600 px-4 py-2 rounded-xl glossy-card font-medium">
                    <i class="fas fa-home mr-2 text-blue-500"></i>Menu Utama
                </a>
                <div class="relative">
                    <button id="userMenuBtn" class="flex items-center space-x-2 text-white hover:bg-white hover:bg-opacity-25 px-3 py-2 rounded-xl transition glossy-card">
                        <i class="fas fa-user-circle text-lg"></i>
                        <span class="hidden md:block font-medium"><%= typeof user !== 'undefined' ? user.name : 'User' %></span>
                        <i class="fas fa-chevron-down text-sm"></i>
                    </button>
                    <div id="userMenuDropdown" class="absolute right-0 mt-3 w-48 glossy-white rounded-xl shadow-lg border hidden z-50">
                        <div class="p-2">
                            <a href="/" class="flex items-center px-4 py-3 text-blue-600 hover:bg-blue-50 rounded-lg glossy-card font-medium md:hidden">
                                <i class="fas fa-home mr-3"></i>Menu Utama
                            </a>
                            <a href="/auth/logout" class="flex items-center px-4 py-3 text-red-600 hover:bg-red-50 rounded-lg glossy-card font-medium">
                                <i class="fas fa-sign-out-alt mr-3"></i>Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- Mobile Tab Menu -->
<div class="md:hidden glossy-gold-light border-t border-white border-opacity-20">
    <div class="flex overflow-x-auto scrollbar-hide">
        <a href="/user/dashboard" class="flex-shrink-0 flex flex-col items-center px-4 py-3 text-gold-dark hover:bg-white hover:bg-opacity-50 transition">
            <i class="fas fa-tachometer-alt text-lg mb-1"></i>
            <span class="text-xs font-medium">Dashboard</span>
        </a>
        <a href="/user/rooms" class="flex-shrink-0 flex flex-col items-center px-4 py-3 text-gold-dark hover:bg-white hover:bg-opacity-50 transition">
            <i class="fas fa-bed text-lg mb-1"></i>
            <span class="text-xs font-medium">Kamar</span>
        </a>
        <a href="/user/bookings" class="flex-shrink-0 flex flex-col items-center px-4 py-3 text-gold-dark hover:bg-white hover:bg-opacity-50 transition">
            <i class="fas fa-calendar-check text-lg mb-1"></i>
            <span class="text-xs font-medium">Booking</span>
        </a>
        <a href="/user/payments" class="flex-shrink-0 flex flex-col items-center px-4 py-3 text-gold-dark hover:bg-white hover:bg-opacity-50 transition">
            <i class="fas fa-credit-card text-lg mb-1"></i>
            <span class="text-xs font-medium">Pembayaran</span>
        </a>
        <a href="/user/complaints" class="flex-shrink-0 flex flex-col items-center px-4 py-3 text-gold-dark hover:bg-white hover:bg-opacity-50 transition">
            <i class="fas fa-exclamation-triangle text-lg mb-1"></i>
            <span class="text-xs font-medium">Pengaduan</span>
        </a>
    </div>
</div>

<style>
.scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
</style>

<script>
    document.getElementById('userMenuBtn').addEventListener('click', function(e) {
        e.stopPropagation();
        document.getElementById('userMenuDropdown').classList.toggle('hidden');
    });

    document.addEventListener('click', function() {
        document.getElementById('userMenuDropdown').classList.add('hidden');
    });
</script>