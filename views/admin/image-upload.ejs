<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Gambar - KostPro Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="admin-bg">
    <style>
        .glossy-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 50%, #1e40af 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .admin-bg {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 30%, #bfdbfe 70%, #3b82f6 100%);
            min-height: 100vh;
        }
    </style>
    <%- include('../partials/admin-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="glossy-white rounded-2xl p-8">
            <h1 class="text-3xl font-bold text-blue-900 mb-6">Upload Gambar Kamar</h1>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Upload Room Type Image -->
                <div class="glossy-white rounded-xl p-6 border">
                    <h2 class="text-xl font-bold text-blue-800 mb-4">
                        <i class="fas fa-image mr-2"></i>Gambar Tipe Kamar
                    </h2>
                    <form action="/admin/images/upload" method="POST">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Tipe Kamar</label>
                            <select name="room_type_id" required class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                                <option value="">Pilih Tipe Kamar</option>
                                <% roomTypes.forEach(roomType => { %>
                                    <option value="<%= roomType.id %>"><%= roomType.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Pilih Gambar</label>
                            <select name="image_choice" required class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                                <option value="">Pilih gambar yang akan digunakan</option>
                                <optgroup label="Gambar Placeholder (Recommended)">
                                    <option value="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&h=400&fit=crop">Kamar Modern 1</option>
                                    <option value="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop">Kamar Modern 2</option>
                                    <option value="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop">Kamar Minimalis</option>
                                    <option value="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=400&fit=crop">Kamar Cozy</option>
                                    <option value="https://images.unsplash.com/photo-1571508601891-ca5e7a713859?w=600&h=400&fit=crop">Kamar Elegant</option>
                                    <option value="https://images.unsplash.com/photo-1540518614846-7eded47432f5?w=600&h=400&fit=crop">Kamar Luxury</option>
                                </optgroup>
                                <optgroup label="Gambar Lokal (Jika Tersedia)">
                                    <option value="Standard-room.jpg">Gambar Tipe Kamar (Standard-room.jpg)</option>
                                    <option value="Kamar Tersedia.jpg">Gambar Kamar Tersedia (Kamar Tersedia.jpg)</option>
                                </optgroup>
                            </select>
                            <p class="text-xs text-blue-600 mt-1">Pilih gambar placeholder atau gambar dari folder lokal</p>
                        </div>
                        <button type="submit" class="glossy-blue text-white px-4 py-2 rounded-lg w-full">
                            <i class="fas fa-upload mr-2"></i>Upload & Terapkan ke Semua Kamar
                        </button>
                    </form>
                </div>

                <!-- Info Panel -->
                <div class="glossy-white rounded-xl p-6 border">
                    <h2 class="text-xl font-bold text-blue-800 mb-4">
                        <i class="fas fa-info-circle mr-2"></i>Cara Kerja
                    </h2>
                    <div class="space-y-3 text-sm text-blue-700">
                        <p><strong>1.</strong> Pilih tipe kamar yang ingin diubah gambarnya</p>
                        <p><strong>2.</strong> Pilih gambar dari folder yang tersedia</p>
                        <p><strong>3.</strong> Klik upload - gambar akan otomatis diterapkan ke:</p>
                        <ul class="ml-4 space-y-1">
                            <li>• Halaman tipe kamar</li>
                            <li>• Semua kamar tersedia dari tipe ini</li>
                            <li>• Home page</li>
                            <li>• Guest dashboard</li>
                        </ul>
                        <div class="mt-4 p-3 bg-blue-50 rounded-lg">
                            <p class="font-medium text-blue-800">Gambar diambil dari folder:</p>
                            <p class="text-xs text-blue-600">/images/[Tipe-Kamar]/[Nama-Gambar].jpg</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Current Images Preview -->
            <div class="mt-8">
                <h2 class="text-xl font-bold text-blue-800 mb-4">Preview Gambar Saat Ini</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="imagePreview">
                    <!-- Images will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        // Handle room type form
        document.getElementById('roomTypeForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            
            try {
                const response = await fetch('/upload/image', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Gambar tipe kamar berhasil diupload!');
                    e.target.reset();
                    loadImagePreview();
                } else {
                    alert('Upload gagal: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        // Handle available room form
        document.getElementById('availableRoomForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            
            try {
                const response = await fetch('/upload/image', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Gambar kamar tersedia berhasil diupload!');
                    e.target.reset();
                    loadImagePreview();
                } else {
                    alert('Upload gagal: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        // Load image preview
        function loadImagePreview() {
            const roomTypes = ['Standard-room', 'Superior-room', 'Deluxe-room', 'Suite-room', 
                             'Share-room', 'Twin-room', 'Large-room', 'President-room'];
            
            const previewDiv = document.getElementById('imagePreview');
            previewDiv.innerHTML = '';
            
            roomTypes.forEach(roomType => {
                const div = document.createElement('div');
                div.className = 'text-center';
                div.innerHTML = `
                    <h3 class="text-sm font-medium text-blue-700 mb-2">${roomType.replace('-', ' ')}</h3>
                    <img src="/images/${roomType}/${roomType}.jpg" 
                         alt="${roomType}" 
                         class="w-full h-24 object-cover rounded-lg mb-2"
                         onerror="this.src='https://via.placeholder.com/150x100/3b82f6/ffffff?text=No+Image'">
                    <img src="/images/${roomType}/Kamar Tersedia.jpg" 
                         alt="Available ${roomType}" 
                         class="w-full h-24 object-cover rounded-lg"
                         onerror="this.src='https://via.placeholder.com/150x100/3b82f6/ffffff?text=No+Image'">
                `;
                previewDiv.appendChild(div);
            });
        }

        // Load preview on page load
        loadImagePreview();
    </script>
</body>
</html>