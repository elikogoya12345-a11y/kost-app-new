<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aktivasi Pembayaran - KostPro User</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="user-bg">
    <style>
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-gold-light {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
        }
        .glossy-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
        .pulse-gold {
            animation: pulse-gold 2s infinite;
        }
        @keyframes pulse-gold {
            0%, 100% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.7); }
            50% { box-shadow: 0 0 0 10px rgba(251, 191, 36, 0); }
        }
    </style>
    <%- include('../partials/user-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <div class="text-center">
                    <i class="fas fa-credit-card text-4xl text-amber-500 mb-4"></i>
                    <h1 class="text-3xl font-bold text-gold-dark mb-2">Aktivasi Pembayaran</h1>
                    <p class="text-gold">Booking berhasil! Aktivasi pembayaran untuk menyelesaikan proses.</p>
                </div>
            </div>
        </div>

        <!-- Booking Summary -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-gold-dark mb-4">
                    <i class="fas fa-info-circle mr-2"></i>Detail Booking
                </h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gold">Tanggal Mulai:</span>
                        <span class="text-gold-dark font-semibold">
                            <%= new Date(multiBooking.start_date).toLocaleDateString('id-ID') %>
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gold">Durasi:</span>
                        <span class="text-gold-dark font-semibold"><%= multiBooking.duration_months %> bulan</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gold">Jumlah Kamar:</span>
                        <span class="text-gold-dark font-semibold"><%= bookings.length %> kamar</span>
                    </div>
                    <div class="border-t border-amber-200 pt-3">
                        <div class="flex justify-between text-lg">
                            <span class="text-gold font-semibold">Total Pembayaran:</span>
                            <span class="text-amber-600 font-bold">
                                Rp <%= parseInt(multiBooking.total_amount).toLocaleString('id-ID') %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-gold-dark mb-4">
                    <i class="fas fa-home mr-2"></i>Tipe Kamar & Ketersediaan
                </h2>
                <div class="space-y-4">
                    <% Object.keys(roomTypeData).forEach(roomTypeId => { %>
                        <div class="border border-amber-200 rounded-lg p-4 bg-amber-50">
                            <div class="flex justify-between items-center">
                                <div>
                                    <h3 class="font-semibold text-gold-dark">
                                        <%= roomTypeData[roomTypeId].name %>
                                    </h3>
                                    <p class="text-sm text-gold">
                                        <i class="fas fa-door-open mr-1"></i>
                                        <%= roomTypeData[roomTypeId].available_count %> kamar tersedia
                                    </p>
                                </div>
                                <div class="text-right">
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                        <i class="fas fa-check mr-1"></i>Tersedia
                                    </span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Room Details -->
        <div class="glossy-white rounded-2xl p-6 glossy-card mb-8">
            <h2 class="text-xl font-bold text-gold-dark mb-4">
                <i class="fas fa-bed mr-2"></i>Kamar yang Dibooking
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% bookings.forEach(booking => { %>
                    <div class="border border-amber-200 rounded-lg p-4 bg-gradient-to-r from-amber-50 to-yellow-50">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-semibold text-gold-dark">Kamar <%= booking.room_number %></h3>
                                <p class="text-sm text-gold"><%= booking.room_type %></p>
                                <p class="text-xs text-amber-600 mt-1">
                                    <i class="fas fa-calendar mr-1"></i>
                                    <%= multiBooking.duration_months %> bulan
                                </p>
                            </div>
                            <div class="text-right">
                                <div class="text-lg font-bold text-amber-600">
                                    Rp <%= parseInt(booking.base_price).toLocaleString('id-ID') %>
                                </div>
                                <div class="text-xs text-gold">per bulan</div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- Payment Activation -->
        <div class="glossy-white rounded-2xl p-6 glossy-card">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-full mb-4">
                    <i class="fas fa-exclamation-triangle text-2xl text-amber-600"></i>
                </div>
                <h2 class="text-2xl font-bold text-gold-dark mb-2">Aktivasi Pembayaran Diperlukan</h2>
                <p class="text-gold mb-4">
                    Untuk menyelesaikan proses booking, Anda perlu mengaktifkan pembayaran. 
                    Setelah aktivasi, jadwal pembayaran bulanan akan dibuat secara otomatis.
                </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <form action="/user/bookings/<%= multiBooking.id %>/activate" method="POST" class="inline">
                    <button type="submit" class="glossy-gold text-white px-8 py-3 rounded-lg pulse-gold hover:opacity-90 transition-all">
                        <i class="fas fa-credit-card mr-2"></i>Aktivasi Pembayaran Sekarang
                    </button>
                </form>
                
                <a href="/user/bookings" class="glossy-gold-light text-gold-dark px-8 py-3 rounded-lg text-center hover:opacity-90 transition-all">
                    <i class="fas fa-arrow-left mr-2"></i>Kembali ke Booking
                </a>
            </div>

            <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <div class="flex items-start">
                    <i class="fas fa-info-circle text-blue-500 mt-1 mr-3"></i>
                    <div class="text-sm text-blue-700">
                        <p class="font-semibold mb-1">Informasi Penting:</p>
                        <ul class="list-disc list-inside space-y-1">
                            <li>Setelah aktivasi, Anda akan diarahkan ke halaman pembayaran</li>
                            <li>Jadwal pembayaran bulanan akan dibuat otomatis</li>
                            <li>Pembayaran pertama jatuh tempo tanggal 10 bulan ini</li>
                            <li>Anda dapat melihat semua tagihan di menu Pembayaran</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Already Paid Section -->
        <div class="glossy-white rounded-2xl p-6 glossy-card mt-8">
            <div class="text-center">
                <h3 class="text-lg font-bold text-gold-dark mb-4">Sudah Bayar?</h3>
                <p class="text-gold mb-4">Jika Anda sudah melakukan pembayaran, klik tombol di bawah untuk konfirmasi.</p>
                <button onclick="confirmPayment()" class="glossy-gold-light text-gold-dark px-6 py-2 rounded-lg hover:opacity-90">
                    <i class="fas fa-check-circle mr-2"></i>Sudah Bayar? Klik Disini
                </button>
            </div>
        </div>
    </div>

    <script>
        function confirmPayment() {
            if (confirm('Apakah Anda yakin sudah melakukan pembayaran? Tindakan ini akan mengaktifkan pembayaran dan membuat jadwal tagihan.')) {
                // Submit the activation form
                document.querySelector('form[action*="/activate"]').submit();
            }
        }
    </script>
</body>
</html>