<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bukti Booking - KostPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; }
        }
    </style>
</head>
<body class="bg-gray-100 p-4">
    <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-lg p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-blue-600 mb-2">KOST PROFESSIONAL</h1>
            <p class="text-gray-600">Bukti Multi Booking Kamar</p>
            <div class="border-b-2 border-blue-600 mt-4"></div>
        </div>

        <div class="grid grid-cols-2 gap-8 mb-8">
            <div>
                <h3 class="font-bold text-gray-800 mb-4">Informasi Penyewa:</h3>
                <p><strong>Nama:</strong> <%= multiBooking.user_name %></p>
                <p><strong>Email:</strong> <%= multiBooking.email %></p>
                <p><strong>Telepon:</strong> <%= multiBooking.phone || '-' %></p>
            </div>
            <div>
                <h3 class="font-bold text-gray-800 mb-4">Detail Booking:</h3>
                <p><strong>ID Booking:</strong> #<%= multiBooking.id %></p>
                <p><strong>Tanggal Booking:</strong> <%= new Date(multiBooking.created_at).toLocaleDateString('id-ID') %></p>
                <p><strong>Status:</strong> <span class="text-green-600 font-semibold">Terkonfirmasi</span></p>
            </div>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg mb-8">
            <h3 class="font-bold text-gray-800 mb-4">Detail Kamar:</h3>
            <% bookings.forEach((booking, index) => { %>
                <div class="<%= index > 0 ? 'border-t border-gray-300 pt-4 mt-4' : '' %>">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p><strong>Kamar <%= index + 1 %>:</strong> <%= booking.room_number %></p>
                            <p><strong>Tipe:</strong> <%= booking.room_type %></p>
                        </div>
                        <div>
                            <p><strong>Harga/Bulan:</strong> Rp <%= parseInt(booking.base_price).toLocaleString('id-ID') %></p>
                            <p><strong>Subtotal:</strong> Rp <%= parseInt(booking.total_amount).toLocaleString('id-ID') %></p>
                        </div>
                    </div>
                </div>
            <% }); %>
            
            <div class="mt-4 pt-4 border-t-2 border-gray-400">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p><strong>Tanggal Mulai:</strong> <%= new Date(multiBooking.start_date).toLocaleDateString('id-ID') %></p>
                        <p><strong>Durasi:</strong> <%= multiBooking.duration_months %> Bulan</p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-bold text-blue-600">
                            Total: Rp <%= parseInt(multiBooking.total_amount).toLocaleString('id-ID') %>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <% if (multiBooking.notes) { %>
        <div class="bg-yellow-50 p-4 rounded-lg mb-8">
            <h4 class="font-semibold text-gray-800 mb-2">Catatan:</h4>
            <p class="text-gray-700"><%= multiBooking.notes %></p>
        </div>
        <% } %>

        <div class="text-center text-sm text-gray-500 mt-8">
            <p>Terima kasih telah memilih Kost Professional</p>
            <p>Dokumen ini dicetak pada <%= new Date().toLocaleDateString('id-ID') %></p>
        </div>

        <div class="text-center mt-8 no-print">
            <button onclick="window.print()" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 mr-4">
                <i class="fas fa-print mr-2"></i>Cetak Bukti
            </button>
            <a href="/user/bookings" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700">
                <i class="fas fa-arrow-left mr-2"></i>Kembali
            </a>
        </div>
    </div>
</body>
</html>