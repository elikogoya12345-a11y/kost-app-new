<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard - Kost Putra</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
            <p class="text-gray-600 mt-2">Selamat datang, <%= user.name %>!</p>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">Total Dibayar</p>
                        <h3 class="text-2xl font-bold">Rp <%= (totalPaid || 0).toLocaleString('id-ID') %></h3>
                        <p class="text-green-100 text-xs mt-1">Semua pembayaran</p>
                    </div>
                    <i class="fas fa-check-circle text-3xl text-green-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm">Pembayaran Berikutnya</p>
                        <% if (nextPayment) { 
                            const dueDate = new Date(nextPayment.due_date);
                            const today = new Date();
                            const diffTime = dueDate - today;
                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        %>
                            <h3 class="text-lg font-bold">
                                <%= new Date(nextPayment.due_date).toLocaleDateString('id-ID') %>
                            </h3>
                            <p class="text-blue-100 text-xs mt-1">
                                Rp <%= nextPayment.amount.toLocaleString('id-ID') %> - 
                                <% if (diffDays > 0) { %>
                                    <%= diffDays %> hari lagi
                                <% } else if (diffDays === 0) { %>
                                    Jatuh tempo hari ini
                                <% } else { %>
                                    Terlambat <%= Math.abs(diffDays) %> hari
                                <% } %>
                            </p>
                            <p class="text-blue-100 text-xs">Kamar <%= nextPayment.room_number %></p>
                        <% } else if (hasPayments) { %>
                            <h3 class="text-lg font-bold">Tidak ada</h3>
                            <p class="text-blue-100 text-xs mt-1">Semua pembayaran lunas</p>
                        <% } else { %>
                            <h3 class="text-lg font-bold">Belum ada</h3>
                            <p class="text-blue-100 text-xs mt-1">Konfirmasi booking untuk mulai pembayaran</p>
                        <% } %>
                    </div>
                    <i class="fas fa-calendar text-3xl text-blue-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-100 text-sm">Notifikasi</p>
                        <h3 class="text-2xl font-bold"><%= notifications.length %></h3>
                        <p class="text-purple-100 text-xs mt-1">Pesan terbaru</p>
                    </div>
                    <i class="fas fa-bell text-3xl text-purple-200"></i>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Aksi Cepat</h2>
                <div class="grid grid-cols-2 gap-4">
                    <a href="/user/rooms" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-bed text-2xl text-blue-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Lihat Kamar</span>
                    </a>
                    <a href="/user/bookings" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-calendar-check text-2xl text-purple-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Booking</span>
                    </a>
                    <a href="/user/payments" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-credit-card text-2xl text-green-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Pembayaran</span>
                    </a>
                    <a href="/user/complaints" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-exclamation-triangle text-2xl text-red-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Pengaduan</span>
                    </a>
                    <button onclick="openPaymentModal()" class="flex flex-col items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <i class="fas fa-clock text-2xl text-yellow-600 mb-2"></i>
                        <span class="text-sm font-medium text-gray-800">Ajukan Telat Bayar</span>
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Notifikasi Terbaru</h2>
                <div class="space-y-3 max-h-64 overflow-y-auto">
                    <% if (notifications.length > 0) { %>
                        <% notifications.forEach(notif => { %>
                            <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg">
                                <h4 class="font-medium text-blue-800 text-sm"><%= notif.title %></h4>
                                <p class="text-blue-600 text-xs mt-1"><%= notif.message %></p>
                                <p class="text-blue-500 text-xs mt-2">
                                    <%= new Date(notif.created_at).toLocaleDateString('id-ID') %>
                                </p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center py-8 text-gray-500">
                            <i class="fas fa-bell-slash text-2xl mb-2"></i>
                            <p>Tidak ada notifikasi</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Extension Modal -->
    <div id="paymentModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
            <form action="/user/payment-extension" method="POST">
                <div class="p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Ajukan Perpanjangan Pembayaran</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Alasan</label>
                            <textarea name="reason" rows="3" required 
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                      placeholder="Jelaskan alasan keterlambatan pembayaran"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Rencana Bayar</label>
                            <input type="date" name="planned_date" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-6 py-4 rounded-b-lg flex justify-end space-x-3">
                    <button type="button" onclick="closePaymentModal()" 
                            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        Kirim Pengajuan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openPaymentModal() {
            document.getElementById('paymentModal').classList.remove('hidden');
            document.getElementById('paymentModal').classList.add('flex');
        }

        function closePaymentModal() {
            document.getElementById('paymentModal').classList.add('hidden');
            document.getElementById('paymentModal').classList.remove('flex');
        }

        document.getElementById('paymentModal').addEventListener('click', function(e) {
            if (e.target.id === 'paymentModal') {
                closePaymentModal();
            }
        });
    </script>
</body>
</html>