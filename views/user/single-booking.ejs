<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Kamar - KostPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gradient-to-br from-yellow-50 to-amber-100 min-h-screen">
    <%- include('../partials/user-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Booking Kamar</h1>
            <p class="text-gray-600">Pilih satu kamar dan langsung lanjut ke pembayaran</p>
            
            <!-- Search Filters -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Filter Tipe Kamar</label>
                    <select id="roomTypeFilter" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="">Semua Tipe Kamar</option>
                        <% const uniqueTypes = [...new Set(rooms.map(r => r.type_name))]; %>
                        <% uniqueTypes.forEach(type => { %>
                            <option value="<%= type %>"><%= type %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Filter Status</label>
                    <select id="statusFilter" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="available">Tersedia</option>
                        <option value="occupied">Tidak Tersedia</option>
                    </select>
                </div>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8" id="roomsContainer">
            <% rooms.forEach(room => { %>
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow room-card" 
                     data-room-id="<%= room.id %>"
                     data-type-name="<%= room.type_name %>"
                     data-status="<%= room.status %>">
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center">
                                <% if (room.status === 'available') { %>
                                    <input type="checkbox" class="room-checkbox mr-3" 
                                           data-room-id="<%= room.id %>"
                                           data-room-type-id="<%= room.room_type_id %>"
                                           data-room-number="<%= room.room_number %>"
                                           data-type-name="<%= room.type_name %>"
                                           data-price="<%= room.base_price %>">
                                <% } else { %>
                                    <input type="checkbox" class="room-checkbox mr-3" disabled>
                                <% } %>
                                <div>
                                    <h3 class="text-xl font-bold text-gray-800">Kamar <%= room.room_number %></h3>
                                    <p class="text-gray-600"><%= room.type_name %></p>
                                </div>
                            </div>
                            <% if (room.status === 'available') { %>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">
                                    Tersedia
                                </span>
                            <% } else { %>
                                <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">
                                    Tidak Tersedia
                                </span>
                            <% } %>
                        </div>
                        
                        <div class="mb-4">
                            <p class="text-2xl font-bold text-amber-600">
                                Rp <%= parseInt(room.base_price).toLocaleString('id-ID') %>
                            </p>
                            <p class="text-sm text-gray-500">per bulan</p>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Booking Form</h2>
            
            <div id="selectedRooms" class="mb-4">
                <p class="text-gray-600">Pilih kamar dengan centang checkbox di atas</p>
            </div>

            <form action="/user/booking" method="POST" id="bookingForm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Mulai</label>
                        <input type="date" name="start_date" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Durasi</label>
                        <select name="duration_months" id="durationSelect" required 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                            <option value="1">1 Bulan</option>
                            <option value="3">3 Bulan</option>
                            <option value="6">6 Bulan</option>
                            <option value="12">12 Bulan</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Catatan (Opsional)</label>
                    <textarea name="notes" rows="3" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                              placeholder="Tambahkan catatan..."></textarea>
                </div>

                <div class="bg-gray-50 rounded-lg p-4 mb-4">
                    <div class="flex justify-between items-center">
                        <span class="font-medium">Total Pembayaran:</span>
                        <span class="text-2xl font-bold text-amber-600" id="totalAmount">Rp 0</span>
                    </div>
                </div>

                <input type="hidden" name="rooms" id="roomsData">
                <input type="hidden" name="total_amount" id="totalAmountInput">

                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-medium py-3 px-4 rounded-lg transition-colors">
                    <i class="fas fa-credit-card mr-2"></i>Booking & Lanjut ke Pembayaran
                </button>
            </form>
        </div>
    </div>



    <script>
        function updateSummary() {
            const checkboxes = document.querySelectorAll('.room-checkbox:checked');
            const duration = parseInt(document.getElementById('durationSelect').value) || 1;
            const selectedRooms = document.getElementById('selectedRooms');
            const totalAmount = document.getElementById('totalAmount');
            const roomsData = document.getElementById('roomsData');
            const totalAmountInput = document.getElementById('totalAmountInput');
            
            if (checkboxes.length === 0) {
                selectedRooms.innerHTML = '<p class="text-gray-600">Pilih kamar dengan centang checkbox di atas</p>';
                totalAmount.textContent = 'Rp 0';
                roomsData.value = '[]';
                totalAmountInput.value = '0';
                return;
            }

            let html = '<div class="space-y-2">';
            let total = 0;
            const rooms = [];

            checkboxes.forEach(cb => {
                const price = parseInt(cb.dataset.price);
                const roomNumber = cb.dataset.roomNumber;
                const typeName = cb.dataset.typeName;
                const subtotal = price * duration;
                total += subtotal;
                
                rooms.push({
                    room_id: parseInt(cb.dataset.roomId),
                    room_type_id: parseInt(cb.dataset.roomTypeId),
                    price: price
                });

                html += `<div class="flex justify-between text-sm bg-gray-50 p-2 rounded">
                    <span>Kamar ${roomNumber} (${typeName})</span>
                    <span class="font-medium">Rp ${subtotal.toLocaleString('id-ID')}</span>
                </div>`;
            });

            html += '</div>';
            selectedRooms.innerHTML = html;
            totalAmount.textContent = 'Rp ' + total.toLocaleString('id-ID');
            roomsData.value = JSON.stringify(rooms);
            totalAmountInput.value = total;
        }

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('room-checkbox') || e.target.id === 'durationSelect') {
                updateSummary();
            }
        });

        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            const checkboxes = document.querySelectorAll('.room-checkbox:checked');
            if (checkboxes.length === 0) {
                e.preventDefault();
                alert('Silakan pilih minimal satu kamar!');
                return false;
            }
        });

        // Filter functionality
        function filterRooms() {
            const typeFilter = document.getElementById('roomTypeFilter').value;
            const statusFilter = document.getElementById('statusFilter').value;
            const roomCards = document.querySelectorAll('.room-card');
            
            roomCards.forEach(card => {
                const roomType = card.dataset.typeName;
                const roomStatus = card.dataset.status;
                
                let showCard = true;
                
                if (typeFilter && roomType !== typeFilter) {
                    showCard = false;
                }
                
                if (statusFilter && roomStatus !== statusFilter) {
                    showCard = false;
                }
                
                card.style.display = showCard ? 'block' : 'none';
            });
        }
        
        document.getElementById('roomTypeFilter').addEventListener('change', filterRooms);
        document.getElementById('statusFilter').addEventListener('change', filterRooms);

        // Real-time room availability check
        function checkRoomAvailability() {
            if (window.realtimeClient && window.realtimeClient.isConnected) {
                window.realtimeClient.checkRoomAvailability();
            }
        }

        // Auto-refresh room availability every 30 seconds
        setInterval(checkRoomAvailability, 30000);

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('input[name="start_date"]').value = new Date().toISOString().split('T')[0];
            updateSummary();
            filterRooms();
            
            // Initial room availability check
            setTimeout(checkRoomAvailability, 1000);
        });
    </script>
</body>
</html>