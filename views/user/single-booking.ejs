<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Kamar - KostPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gradient-to-br from-yellow-50 to-amber-100 min-h-screen">
    <%- include('../partials/user-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Booking Kamar</h1>
            <p class="text-gray-600">Pilih satu kamar dan langsung lanjut ke pembayaran</p>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% rooms.forEach(room => { %>
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-xl font-bold text-gray-800">Kamar <%= room.room_number %></h3>
                                <p class="text-gray-600"><%= room.type_name %></p>
                            </div>
                            <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">
                                Tersedia
                            </span>
                        </div>
                        
                        <div class="mb-4">
                            <p class="text-2xl font-bold text-amber-600">
                                Rp <%= parseInt(room.base_price).toLocaleString('id-ID') %>
                            </p>
                            <p class="text-sm text-gray-500">per bulan</p>
                        </div>

                        <button onclick="bookRoom(<%= room.id %>, <%= room.room_type_id %>, '<%= room.room_number %>', '<%= room.type_name %>', <%= room.base_price %>)" 
                                class="w-full bg-amber-500 hover:bg-amber-600 text-white font-medium py-2 px-4 rounded-lg transition-colors">
                            <i class="fas fa-calendar-plus mr-2"></i>Book Kamar Ini
                        </button>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- Booking Modal -->
    <div id="bookingModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-xl max-w-md w-full p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Booking Kamar</h2>
                    <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <form action="/user/booking" method="POST">
                    <div class="mb-4">
                        <p class="text-gray-600 mb-2">Kamar yang dipilih:</p>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="font-medium" id="selectedRoom"></p>
                            <p class="text-sm text-gray-600" id="selectedType"></p>
                            <p class="text-lg font-bold text-amber-600" id="selectedPrice"></p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Mulai</label>
                        <input type="date" name="start_date" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Durasi</label>
                        <select name="duration_months" id="durationSelect" required 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                            <option value="1">1 Bulan</option>
                            <option value="3">3 Bulan</option>
                            <option value="6">6 Bulan</option>
                            <option value="12">12 Bulan</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Catatan (Opsional)</label>
                        <textarea name="notes" rows="3" 
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                                  placeholder="Tambahkan catatan..."></textarea>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-3 mb-4">
                        <div class="flex justify-between items-center">
                            <span class="font-medium">Total Pembayaran:</span>
                            <span class="text-xl font-bold text-amber-600" id="totalAmount">Rp 0</span>
                        </div>
                    </div>

                    <input type="hidden" name="room_id" id="roomId">
                    <input type="hidden" name="room_type_id" id="roomTypeId">

                    <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-medium py-3 px-4 rounded-lg transition-colors">
                        <i class="fas fa-credit-card mr-2"></i>Booking & Lanjut ke Pembayaran
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let currentPrice = 0;

        function bookRoom(roomId, roomTypeId, roomNumber, typeName, price) {
            currentPrice = price;
            
            document.getElementById('roomId').value = roomId;
            document.getElementById('roomTypeId').value = roomTypeId;
            document.getElementById('selectedRoom').textContent = 'Kamar ' + roomNumber;
            document.getElementById('selectedType').textContent = typeName;
            document.getElementById('selectedPrice').textContent = 'Rp ' + price.toLocaleString('id-ID') + '/bulan';
            
            updateTotal();
            
            // Set default date
            document.querySelector('input[name="start_date"]').value = new Date().toISOString().split('T')[0];
            
            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function updateTotal() {
            const duration = parseInt(document.getElementById('durationSelect').value) || 1;
            const total = currentPrice * duration;
            document.getElementById('totalAmount').textContent = 'Rp ' + total.toLocaleString('id-ID');
        }

        document.getElementById('durationSelect').addEventListener('change', updateTotal);

        // Close modal when clicking outside
        document.getElementById('bookingModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    </script>
</body>
</html>