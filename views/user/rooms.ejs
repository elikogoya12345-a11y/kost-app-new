<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kamar - KostPro User</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="user-bg">
    <style>
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
        }
        .glossy-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
    </style>
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gold-dark">Tipe Kamar Tersedia</h1>
                        <p class="text-gold mt-2">Pilih tipe kamar yang sesuai dengan kebutuhan Anda</p>
                    </div>
                    <% if (typeof booking !== 'undefined' && booking) { %>
                        <a href="/user/bookings" class="glossy-gold-light text-gold-dark px-4 py-2 rounded-lg hover:opacity-90 transition-opacity">
                            <i class="fas fa-arrow-left mr-2"></i>Kembali ke Booking
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="glossy-white rounded-2xl p-6 mb-8 glossy-card">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <input type="text" id="searchInput" placeholder="Cari tipe kamar..." 
                           class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                </div>
                <div>
                    <select id="roomTypeFilter" class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                        <option value="all">Semua Tipe Kamar</option>
                        <option value="Standard Room">Standard Room</option>
                        <option value="Superior Room">Superior Room</option>
                        <option value="Deluxe Room">Deluxe Room</option>
                        <option value="Suite Room">Suite Room</option>
                        <option value="Share Room">Share Room</option>
                        <option value="Large Room">Large Room</option>
                        <option value="President Room">President Room</option>
                    </select>
                </div>
                <div>
                    <select id="statusFilter" class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                        <option value="all">Semua Status</option>
                        <option value="available">Tersedia</option>
                        <option value="unavailable">Tidak Tersedia</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (roomTypes.length > 0) { %>
                <% roomTypes.forEach(roomType => { %>
                    <div class="glossy-white rounded-2xl overflow-hidden glossy-card">
                        <div class="h-48 relative overflow-hidden">
                            <% 
                                let roomImageUrl;
                                switch(roomType.name) {
                                    case 'Standard Room': roomImageUrl = 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop'; break;
                                    case 'Superior Room': roomImageUrl = 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop'; break;
                                    case 'Deluxe Room': roomImageUrl = 'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=400&fit=crop'; break;
                                    case 'Suite Room': roomImageUrl = 'https://images.unsplash.com/photo-1571508601891-ca5e7a713859?w=600&h=400&fit=crop'; break;
                                    case 'Share Room': roomImageUrl = 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&h=400&fit=crop'; break;
                                    case 'Large Room': roomImageUrl = 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=600&h=400&fit=crop'; break;
                                    case 'President Room': roomImageUrl = 'https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=600&h=400&fit=crop'; break;
                                    default: roomImageUrl = 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop';
                                }
                            %>
                            <img src="<%= roomType.image_url || roomImageUrl %>" 
                                 alt="<%= roomType.name %>" 
                                 class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center">
                                <div class="text-center text-white">
                                    <i class="fas fa-bed text-3xl mb-2"></i>
                                    <p class="font-bold text-lg"><%= roomType.name %></p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gold-dark mb-2"><%= roomType.name %></h3>
                            <p class="text-gold mb-4"><%= roomType.description %></p>
                            
                            <div class="mb-4">
                                <h4 class="font-semibold text-gold-dark mb-2">Fasilitas:</h4>
                                <div class="flex flex-wrap gap-1">
                                    <% if (roomType.facilities) { %>
                                        <% try { %>
                                            <% const facilities = JSON.parse(roomType.facilities); %>
                                            <% facilities.slice(0, 3).forEach(facility => { %>
                                                <span class="glossy-white text-blue-600 text-xs px-2 py-1 rounded-full border border-blue-200"><%= facility %></span>
                                            <% }); %>
                                            <% if (facilities.length > 3) { %>
                                                <span class="text-xs text-blue-500">+<%= facilities.length - 3 %> lainnya</span>
                                            <% } %>
                                        <% } catch(e) { %>
                                            <span class="text-xs text-blue-500">Fasilitas lengkap</span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex justify-between items-center mb-4">
                                <span class="text-2xl font-bold text-amber-600">
                                    Rp <% 
                                        const price = parseInt(roomType.base_price);
                                        if (price >= 1000000) {
                                            const millions = price / 1000000;
                                            if (millions % 1 === 0) {
                                    %><%= millions %> Juta<% } else { %><%= millions.toFixed(1) %> Juta<% } 
                                        } else if (price >= 1000) {
                                            const thousands = price / 1000;
                                    %><%= thousands %> Ribu<% } else { %><%= price %><% } %>
                                </span>
                                <span class="text-sm text-blue-500">per bulan</span>
                            </div>
                            
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-sm font-medium text-gold-dark">
                                    <% if (roomType.available_rooms > 0) { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-check-circle mr-1"></i>Tersedia (<%= roomType.available_rooms %> kamar)
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <i class="fas fa-times-circle mr-1"></i>Tidak Tersedia
                                        </span>
                                    <% } %>
                                </span>
                            </div>
                            
                            <div class="flex space-x-2">
                                <% if (roomType.available_rooms > 0) { %>
                                    <a href="/user/rooms/<%= roomType.id %><% if (typeof booking !== 'undefined' && booking) { %>?booking=true<% } %>" 
                                       class="flex-1 glossy-gold text-white px-4 py-3 rounded-xl glossy-card text-center font-medium">
                                        <i class="fas fa-eye mr-2"></i>Lihat Kamar
                                    </a>
                                <% } else { %>
                                    <button disabled 
                                            class="flex-1 bg-gray-400 text-white px-4 py-3 rounded-xl cursor-not-allowed text-center">
                                        <i class="fas fa-times mr-2"></i>Tidak Tersedia
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full">
                    <div class="glossy-white rounded-2xl p-12 text-center glossy-card">
                        <i class="fas fa-bed text-4xl text-gold mb-4"></i>
                        <h3 class="text-xl font-semibold text-gold-dark mb-2">Belum Ada Tipe Kamar</h3>
                        <p class="text-gold">Tipe kamar akan segera tersedia</p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const roomTypeFilter = document.getElementById('roomTypeFilter');
        const statusFilter = document.getElementById('statusFilter');
        const roomCards = document.querySelectorAll('.glossy-white.rounded-2xl.overflow-hidden');
        const isBookingMode = new URLSearchParams(window.location.search).has('booking');

        function filterRooms() {
            const searchTerm = searchInput.value.toLowerCase();
            const roomTypeValue = roomTypeFilter.value;
            const statusValue = statusFilter.value;

            roomCards.forEach(card => {
                const roomName = card.querySelector('h3').textContent;
                const isAvailable = !card.querySelector('button[disabled]');
                
                let showCard = true;
                
                // Search filter
                if (searchTerm && !roomName.toLowerCase().includes(searchTerm)) {
                    showCard = false;
                }
                
                // Room type filter
                if (roomTypeValue !== 'all' && roomName !== roomTypeValue) {
                    showCard = false;
                }
                
                // Status filter
                if (statusValue === 'available' && !isAvailable) {
                    showCard = false;
                } else if (statusValue === 'unavailable' && isAvailable) {
                    showCard = false;
                }
                
                card.style.display = showCard ? 'block' : 'none';
            });
        }

        searchInput.addEventListener('input', filterRooms);
        roomTypeFilter.addEventListener('change', filterRooms);
        statusFilter.addEventListener('change', filterRooms);
        
        // Add booking mode indicator
        if (isBookingMode) {
            document.querySelector('h1').innerHTML += ' <span class="text-sm bg-blue-100 text-blue-800 px-2 py-1 rounded-full">Mode Booking</span>';
        }
    </script>
</body>
</html>