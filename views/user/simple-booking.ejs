<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Kamar - KostPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gradient-to-br from-yellow-50 to-amber-100 min-h-screen">
    <%- include('../partials/user-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Booking Kamar</h1>
            <p class="text-gray-600">Pilih kamar dan langsung lanjut ke pembayaran</p>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
            </div>
        <% } %>

        <form action="/user/booking" method="POST" class="bg-white rounded-xl shadow-lg p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Mulai</label>
                    <input type="date" name="start_date" required 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Durasi</label>
                    <select name="duration_months" required 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="1">1 Bulan</option>
                        <option value="3">3 Bulan</option>
                        <option value="6">6 Bulan</option>
                        <option value="12">12 Bulan</option>
                    </select>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Kamar</label>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% rooms.forEach(room => { %>
                        <div class="border border-gray-200 rounded-lg p-4 hover:border-amber-500 transition-colors">
                            <div class="flex items-center mb-2">
                                <input type="checkbox" name="selected_rooms" value="<%= room.id %>" 
                                       data-price="<%= room.base_price %>" 
                                       data-type-id="<%= room.room_type_id %>"
                                       class="mr-2 room-checkbox">
                                <label class="font-medium text-gray-800">Kamar <%= room.room_number %></label>
                            </div>
                            <p class="text-sm text-gray-600 mb-2"><%= room.type_name %></p>
                            <p class="text-lg font-bold text-amber-600">
                                Rp <%= parseInt(room.base_price).toLocaleString('id-ID') %>/bulan
                            </p>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Catatan (Opsional)</label>
                <textarea name="notes" rows="3" 
                          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                          placeholder="Tambahkan catatan..."></textarea>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="font-medium text-gray-800 mb-2">Ringkasan</h3>
                <div id="summary">
                    <p class="text-gray-600">Pilih kamar untuk melihat total</p>
                </div>
            </div>

            <input type="hidden" name="rooms" id="roomsData">
            <input type="hidden" name="total_amount" id="totalAmount">

            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-medium py-3 px-4 rounded-md transition-colors">
                <i class="fas fa-credit-card mr-2"></i>Booking & Lanjut ke Pembayaran
            </button>
        </form>
    </div>

    <script>
        const checkboxes = document.querySelectorAll('.room-checkbox');
        const summary = document.getElementById('summary');
        const roomsData = document.getElementById('roomsData');
        const totalAmount = document.getElementById('totalAmount');
        const durationSelect = document.querySelector('select[name="duration_months"]');

        function updateSummary() {
            const selected = Array.from(checkboxes).filter(cb => cb.checked);
            const duration = parseInt(durationSelect.value) || 1;
            
            if (selected.length === 0) {
                summary.innerHTML = '<p class="text-gray-600">Pilih kamar untuk melihat total</p>';
                roomsData.value = '[]';
                totalAmount.value = '0';
                return;
            }

            let total = 0;
            const rooms = [];
            let html = '<div class="space-y-2">';

            selected.forEach(cb => {
                const price = parseInt(cb.dataset.price);
                const roomNumber = cb.parentElement.querySelector('label').textContent;
                total += price * duration;
                
                rooms.push({
                    room_id: parseInt(cb.value),
                    room_type_id: parseInt(cb.dataset.typeId),
                    price: price
                });

                html += `<div class="flex justify-between text-sm">
                    <span>${roomNumber}</span>
                    <span>Rp ${(price * duration).toLocaleString('id-ID')}</span>
                </div>`;
            });

            html += `<div class="border-t pt-2 mt-2">
                <div class="flex justify-between font-medium">
                    <span>Total (${duration} bulan):</span>
                    <span class="text-amber-600">Rp ${total.toLocaleString('id-ID')}</span>
                </div>
            </div></div>`;

            summary.innerHTML = html;
            roomsData.value = JSON.stringify(rooms);
            totalAmount.value = total;
        }

        checkboxes.forEach(cb => cb.addEventListener('change', updateSummary));
        durationSelect.addEventListener('change', updateSummary);

        // Set default date
        document.querySelector('input[name="start_date"]').value = new Date().toISOString().split('T')[0];
        
        updateSummary();
    </script>
</body>
</html>