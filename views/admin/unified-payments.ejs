<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Pembayaran - KostPro Admin</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
        .tab-active { @apply bg-blue-600 text-white; }
        .tab-inactive { @apply bg-gray-200 text-gray-700 hover:bg-gray-300; }
    </style>
</head>
<body class="bg-gray-50">
    <%- include('../partials/admin-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">Kelola Pembayaran & Transaksi</h1>
                    <p class="text-gray-600 mt-2">Manajemen terpadu semua pembayaran dan transaksi</p>
                </div>
                <div class="flex gap-3 no-print">
                    <button onclick="printReport()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium">
                        <i class="fas fa-print mr-2"></i>Cetak Laporan
                    </button>
                    <button onclick="openTransactionModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium">
                        <i class="fas fa-plus mr-2"></i>Transaksi Baru
                    </button>
                </div>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>



        <!-- Filter Section -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-8 no-print">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Filter & Pencarian</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Dari Tanggal</label>
                    <input type="date" id="startDate" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Sampai Tanggal</label>
                    <input type="date" id="endDate"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select id="statusFilter"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Semua Status</option>
                        <option value="paid">Lunas</option>
                        <option value="pending">Pending</option>
                        <option value="overdue">Terlambat</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Pencarian</label>
                    <input type="text" id="searchInput" placeholder="Nama, kamar, kategori..."
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            
            <div class="flex gap-3">
                <button onclick="applyFilter()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium">
                    <i class="fas fa-filter mr-2"></i>Terapkan Filter
                </button>
                <button onclick="resetFilter()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium">
                    <i class="fas fa-undo mr-2"></i>Reset
                </button>
            </div>
        </div>

        <div id="printArea">
            <!-- Print Header -->
            <div class="hidden print:block mb-8">
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">Kost Professional</h1>
                    <h2 class="text-xl font-semibold text-gray-700 mb-4">Laporan Pembayaran & Transaksi</h2>
                    <p class="text-gray-600" id="printPeriod"></p>
                    <p class="text-sm text-gray-500">Dicetak pada: <span id="printDate"></span></p>
                </div>
            </div>

            <!-- Summary Statistics -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-8">
                <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-100 text-sm">Lunas</p>
                            <h3 class="text-2xl font-bold" id="totalPaid">0</h3>
                        </div>
                        <i class="fas fa-check-circle text-3xl text-green-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-yellow-100 text-sm">Pending</p>
                            <h3 class="text-2xl font-bold" id="totalPending">0</h3>
                        </div>
                        <i class="fas fa-clock text-3xl text-yellow-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-red-100 text-sm">Terlambat</p>
                            <h3 class="text-2xl font-bold" id="totalOverdue">0</h3>
                        </div>
                        <i class="fas fa-exclamation-triangle text-3xl text-red-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-blue-100 text-sm">Pemasukan</p>
                            <h3 class="text-lg font-bold" id="totalIncome">Rp 0</h3>
                        </div>
                        <i class="fas fa-arrow-up text-3xl text-blue-200"></i>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-purple-100 text-sm">Pengeluaran</p>
                            <h3 class="text-lg font-bold" id="totalExpense">Rp 0</h3>
                        </div>
                        <i class="fas fa-arrow-down text-3xl text-purple-200"></i>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800">Daftar Pembayaran Penghuni</h2>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Penghuni</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kamar</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Periode</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jumlah</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jatuh Tempo</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider no-print">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Data will be loaded here -->
                        </tbody>
                    </table>
                </div>
                
                <!-- No Data Message -->
                <div id="noDataMessage" class="hidden px-6 py-12 text-center">
                    <i class="fas fa-search text-4xl text-gray-400 mb-4"></i>
                    <h3 class="text-lg font-semibold text-gray-600 mb-2">Tidak Ada Data</h3>
                    <p class="text-gray-500">Tidak ada data yang sesuai dengan filter yang dipilih</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction Modal -->
    <div id="transactionModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50 no-print">
        <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-2xl shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-gray-900">Transaksi Baru</h3>
                    <button onclick="closeTransactionModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                
                <form id="transactionForm" action="/admin/transactions" method="POST">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal</label>
                            <input type="date" name="transaction_date" required
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tipe</label>
                            <select name="type" required
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">Pilih tipe...</option>
                                <option value="income">Pemasukan</option>
                                <option value="expense">Pengeluaran</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Kategori</label>
                            <select name="category" required
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">Pilih kategori...</option>
                                <option value="Utilitas">Utilitas</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Operasional">Operasional</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Jumlah</label>
                            <input type="number" name="total_amount" min="0" step="1000" required
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Deskripsi</label>
                        <textarea name="description" rows="3" required
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                    </div>

                    <div class="flex justify-end space-x-3">
                        <button type="button" onclick="closeTransactionModal()" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                            Batal
                        </button>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                            <i class="fas fa-save mr-2"></i>Simpan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        let allData = [];
        let filteredData = [];

        document.addEventListener('DOMContentLoaded', function() {
            loadData();
            
            // Set default date range (current month)
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            document.getElementById('startDate').value = firstDay.toISOString().split('T')[0];
            document.getElementById('endDate').value = lastDay.toISOString().split('T')[0];
        });

        async function loadData() {
            try {
                const [paymentsRes, transactionsRes] = await Promise.all([
                    fetch('/admin/api/payment-transactions'),
                    fetch('/admin/api/transactions')
                ]);

                const paymentsData = await paymentsRes.json();
                const transactionsData = await transactionsRes.json();

                // Combine and format data
                allData = [
                    ...(paymentsData.transactions || []).map(p => ({...p, data_type: 'payment'})),
                    ...(transactionsData.transactions || []).map(t => ({...t, data_type: 'transaction'}))
                ];

                filteredData = [...allData];
                renderData();
                updateStatistics();
            } catch (error) {
                console.error('Error loading data:', error);
                showNoDataMessage();
            }
        }



        function renderData() {
            const tbody = document.getElementById('dataTableBody');
            const noDataMessage = document.getElementById('noDataMessage');
            
            const payments = filteredData.filter(d => d.data_type === 'payment');
            
            if (payments.length === 0) {
                tbody.innerHTML = '';
                noDataMessage.classList.remove('hidden');
                return;
            }
            
            noDataMessage.classList.add('hidden');
            tbody.innerHTML = payments.map(renderPaymentRow).join('');
        }

        function renderPaymentRow(payment) {
            const dueDate = new Date(payment.due_date);
            const today = new Date();
            const diffTime = dueDate - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            return `
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">#PAY-${String(payment.id).padStart(5, '0')}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">${payment.user_name}</div>
                        <div class="text-xs text-gray-500">${payment.user_email || ''}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">Kamar ${payment.room_number}</div>
                        <div class="text-xs text-gray-500">${payment.room_type}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${formatMonth(payment.due_date)}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-gray-900">Rp ${parseFloat(payment.amount).toLocaleString('id-ID')}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${new Date(payment.due_date).toLocaleDateString('id-ID')}</div>
                        ${payment.status === 'pending' && diffDays >= 0 ? 
                            `<div class="text-xs text-blue-600">${diffDays} hari lagi</div>` :
                            payment.status === 'pending' && diffDays < 0 ?
                            `<div class="text-xs text-red-600">Terlambat ${Math.abs(diffDays)} hari</div>` : ''
                        }
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        ${getStatusBadge(payment.status)}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium no-print">
                        ${payment.status !== 'paid' ? 
                            `<button onclick="updatePaymentStatus(${payment.id}, 'paid')" class="text-green-600 hover:text-green-900 mr-3">
                                <i class="fas fa-check mr-1"></i>Konfirmasi
                            </button>` : ''
                        }
                    </td>
                </tr>
            `;
        }

        function renderTransactionRow(transaction) {
            return `
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">#TRX-${String(transaction.id).padStart(5, '0')}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${new Date(transaction.transaction_date).toLocaleDateString('id-ID')}</div>
                    </td>
                    ${currentTab === 'all' ? `
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">
                                Transaksi
                            </span>
                        </td>
                    ` : ''}
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">${transaction.category}</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm text-gray-900">${transaction.description || '-'}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        ${transaction.type === 'income' ? 
                            '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800"><i class="fas fa-arrow-up mr-1"></i>Pemasukan</span>' :
                            '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800"><i class="fas fa-arrow-down mr-1"></i>Pengeluaran</span>'
                        }
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold ${transaction.type === 'income' ? 'text-green-600' : 'text-red-600'}">
                            Rp ${parseFloat(transaction.total_amount).toLocaleString('id-ID')}
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium no-print">
                        <button onclick="deleteTransaction(${transaction.id})" class="text-red-600 hover:text-red-900">
                            <i class="fas fa-trash mr-1"></i>Hapus
                        </button>
                    </td>
                </tr>
            `;
        }

        function updateStatistics() {
            const payments = filteredData.filter(d => d.data_type === 'payment');
            const transactions = filteredData.filter(d => d.data_type === 'transaction');
            
            const totalPaid = payments.filter(p => p.status === 'paid').length;
            const totalPending = payments.filter(p => p.status === 'pending').length;
            const totalOverdue = payments.filter(p => p.status === 'overdue').length;
            
            const totalIncome = [
                ...payments.filter(p => p.status === 'paid'),
                ...transactions.filter(t => t.type === 'income')
            ].reduce((sum, item) => sum + parseFloat(item.amount || item.total_amount || 0), 0);
            
            const totalExpense = transactions.filter(t => t.type === 'expense')
                .reduce((sum, t) => sum + parseFloat(t.total_amount), 0);

            document.getElementById('totalPaid').textContent = totalPaid;
            document.getElementById('totalPending').textContent = totalPending;
            document.getElementById('totalOverdue').textContent = totalOverdue;
            document.getElementById('totalIncome').textContent = `Rp ${totalIncome.toLocaleString('id-ID')}`;
            document.getElementById('totalExpense').textContent = `Rp ${totalExpense.toLocaleString('id-ID')}`;
        }

        function applyFilter() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const status = document.getElementById('statusFilter').value;
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();

            filteredData = allData.filter(item => {
                let matches = true;

                // Only show payments
                if (item.data_type !== 'payment') return false;

                // Date filter
                const itemDate = new Date(item.due_date);
                if (startDate) matches = matches && itemDate >= new Date(startDate);
                if (endDate) matches = matches && itemDate <= new Date(endDate);

                // Status filter
                if (status && item.status) matches = matches && item.status === status;

                // Search filter
                if (searchTerm) {
                    const searchFields = [
                        item.user_name, item.room_number, item.room_type
                    ].filter(Boolean).join(' ').toLowerCase();
                    matches = matches && searchFields.includes(searchTerm);
                }

                return matches;
            });

            renderData();
            updateStatistics();
        }

        function resetFilter() {
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('searchInput').value = '';
            
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            document.getElementById('startDate').value = firstDay.toISOString().split('T')[0];
            document.getElementById('endDate').value = lastDay.toISOString().split('T')[0];
            
            filteredData = [...allData];
            renderData();
            updateStatistics();
        }

        async function updatePaymentStatus(id, status) {
            if (confirm('Apakah Anda yakin ingin mengkonfirmasi pembayaran ini?')) {
                try {
                    const response = await fetch(`/admin/payments/${id}/update`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `status=${status}`
                    });
                    if (response.ok) {
                        location.reload();
                    }
                } catch (error) {
                    alert('Gagal mengupdate status pembayaran');
                }
            }
        }

        async function deleteTransaction(id) {
            if (confirm('Apakah Anda yakin ingin menghapus transaksi ini?')) {
                try {
                    const response = await fetch(`/admin/transactions/${id}/delete`, {
                        method: 'POST'
                    });
                    if (response.ok) {
                        location.reload();
                    }
                } catch (error) {
                    alert('Gagal menghapus transaksi');
                }
            }
        }

        function openTransactionModal() {
            document.getElementById('transactionModal').classList.remove('hidden');
        }

        function closeTransactionModal() {
            document.getElementById('transactionModal').classList.add('hidden');
        }

        function printReport() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            let period = 'Semua Periode';
            if (startDate && endDate) {
                period = `${new Date(startDate).toLocaleDateString('id-ID')} - ${new Date(endDate).toLocaleDateString('id-ID')}`;
            }
            
            document.getElementById('printPeriod').textContent = `Periode: ${period}`;
            document.getElementById('printDate').textContent = new Date().toLocaleDateString('id-ID', {
                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
            });
            
            window.print();
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'paid':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800"><i class="fas fa-check mr-1"></i>Lunas</span>';
                case 'pending':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800"><i class="fas fa-clock mr-1"></i>Pending</span>';
                case 'overdue':
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800"><i class="fas fa-exclamation-triangle mr-1"></i>Terlambat</span>';
                default:
                    return '<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Unknown</span>';
            }
        }

        function formatMonth(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long' });
        }

        function showNoDataMessage() {
            document.getElementById('dataTableBody').innerHTML = '';
            document.getElementById('noDataMessage').classList.remove('hidden');
        }

        // Enter key search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') applyFilter();
        });

        // Form submission confirmation
        document.getElementById('transactionForm').addEventListener('submit', function(e) {
            e.preventDefault();
            if (confirm('Apakah Anda yakin ingin menyimpan transaksi ini?')) {
                this.submit();
            }
        });
    </script>
</body>
</html>