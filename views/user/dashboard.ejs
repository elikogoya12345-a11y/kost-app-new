<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard - Kost Putra Medang</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* USER THEME: Gold Glossy Dominant with Blue Accents */
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(20px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-gold-light {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.3);
            border: 1px solid rgba(251, 191, 36, 0.2);
        }
        .glossy-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #1e40af 50%, #1d4ed8 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 35px rgba(59, 130, 246, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f8fafc 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
        }
        .glossy-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
        .text-blue-medium {
            color: #1d4ed8;
        }
    </style>
</head>
<body class="user-bg">
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="glossy-gold rounded-2xl p-8 glossy-card">
                <div class="flex items-center space-x-4 mb-4">
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-user text-2xl text-blue-600"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold text-white">Dashboard Penghuni</h1>
                        <p class="text-amber-100 mt-1">Selamat datang, <%= user.name %>! Nikmati pengalaman tinggal yang nyaman.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <div class="glossy-gold rounded-2xl p-6 text-white glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-amber-100 text-sm font-medium">Total Dibayar</p>
                        <h3 class="text-2xl font-bold">Rp <%= (totalPaid || 0).toLocaleString('id-ID') %></h3>
                        <p class="text-amber-100 text-xs mt-1">Semua pembayaran</p>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-check-circle text-2xl text-green-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 text-gold-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gold text-sm font-medium">Pembayaran Berikutnya</p>
                        <% if (nextPayment) { 
                            const dueDate = new Date(nextPayment.due_date);
                            const today = new Date();
                            const diffTime = dueDate - today;
                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        %>
                            <h3 class="text-lg font-bold text-gold-dark">
                                <%= new Date(nextPayment.due_date).toLocaleDateString('id-ID') %>
                            </h3>
                            <p class="text-gold text-xs mt-1">
                                Rp <%= nextPayment.amount.toLocaleString('id-ID') %> - 
                                <% if (diffDays > 0) { %>
                                    <%= diffDays %> hari lagi
                                <% } else if (diffDays === 0) { %>
                                    Jatuh tempo hari ini
                                <% } else { %>
                                    Terlambat <%= Math.abs(diffDays) %> hari
                                <% } %>
                            </p>
                            <p class="text-gold text-xs">Kamar <%= nextPayment.room_number %></p>
                        <% } else if (hasPayments) { %>
                            <h3 class="text-lg font-bold text-gold-dark">Tidak ada</h3>
                            <p class="text-gold text-xs mt-1">Semua pembayaran lunas</p>
                        <% } else { %>
                            <h3 class="text-lg font-bold text-gold-dark">Belum ada</h3>
                            <p class="text-gold text-xs mt-1">Konfirmasi booking untuk mulai pembayaran</p>
                        <% } %>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card border border-blue-200">
                        <i class="fas fa-calendar text-2xl text-blue-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-gold-light rounded-2xl p-6 text-gold-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gold text-sm font-medium">Notifikasi</p>
                        <h3 class="text-2xl font-bold"><%= notifications.length %></h3>
                        <p class="text-gold text-xs mt-1">Pesan terbaru</p>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card border border-blue-200">
                        <i class="fas fa-bell text-2xl text-blue-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-gold-dark mb-6">Aksi Cepat</h2>
                <div class="grid grid-cols-2 gap-4">
                    <a href="/user/rooms" class="flex flex-col items-center p-4 glossy-gold text-white rounded-xl glossy-card">
                        <i class="fas fa-bed text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Lihat Kamar</span>
                    </a>
                    <a href="/user/bookings" class="flex flex-col items-center p-4 glossy-white text-blue-600 rounded-xl glossy-card border border-blue-200">
                        <i class="fas fa-calendar-check text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Booking</span>
                    </a>
                    <a href="/user/payments" class="flex flex-col items-center p-4 glossy-gold text-white rounded-xl glossy-card">
                        <i class="fas fa-credit-card text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Pembayaran</span>
                    </a>
                    <a href="/user/complaints" class="flex flex-col items-center p-4 glossy-white text-blue-600 rounded-xl glossy-card border border-blue-200">
                        <i class="fas fa-exclamation-triangle text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Pengaduan</span>
                    </a>
                    <button onclick="openPaymentModal()" class="flex flex-col items-center p-4 glossy-white text-blue-600 rounded-xl glossy-card col-span-2 border border-blue-200">
                        <i class="fas fa-clock text-2xl text-blue-500 mb-3"></i>
                        <span class="text-sm font-medium">Ajukan Perpanjangan Pembayaran</span>
                    </button>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-gold-dark mb-6">Notifikasi Terbaru</h2>
                <div class="space-y-3 max-h-64 overflow-y-auto">
                    <% if (notifications.length > 0) { %>
                        <% notifications.forEach(notif => { %>
                            <div class="p-4 glossy-gold-light border border-amber-200 rounded-xl glossy-card">
                                <h4 class="font-medium text-gold-dark text-sm"><%= notif.title %></h4>
                                <p class="text-gold text-xs mt-1"><%= notif.message %></p>
                                <p class="text-amber-600 text-xs mt-2">
                                    <%= new Date(notif.created_at).toLocaleDateString('id-ID') %>
                                </p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center py-8 text-gold">
                            <i class="fas fa-bell-slash text-2xl mb-2"></i>
                            <p>Tidak ada notifikasi</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Extension Modal -->
    <div id="paymentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
        <div class="glossy-white rounded-2xl w-full max-w-md glossy-card">
            <form action="/user/payment-extension" method="POST">
                <div class="p-6">
                    <h3 class="text-lg font-bold text-gold-dark mb-4">Ajukan Perpanjangan Pembayaran</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gold mb-2">Alasan</label>
                            <textarea name="reason" rows="3" required 
                                      class="w-full px-3 py-2 border border-amber-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
                                      placeholder="Jelaskan alasan keterlambatan pembayaran"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gold mb-2">Tanggal Rencana Bayar</label>
                            <input type="date" name="planned_date" required 
                                   class="w-full px-3 py-2 border border-amber-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                        </div>
                    </div>
                </div>
                <div class="glossy-gold-light px-6 py-4 rounded-b-2xl flex justify-end space-x-3">
                    <button type="button" onclick="closePaymentModal()" 
                            class="px-4 py-2 border border-amber-300 rounded-xl text-gold hover:bg-amber-100 glossy-card">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-4 py-2 glossy-gold text-white rounded-xl glossy-card">
                        Kirim Pengajuan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openPaymentModal() {
            document.getElementById('paymentModal').classList.remove('hidden');
            document.getElementById('paymentModal').classList.add('flex');
        }

        function closePaymentModal() {
            document.getElementById('paymentModal').classList.add('hidden');
            document.getElementById('paymentModal').classList.remove('flex');
        }

        document.getElementById('paymentModal').addEventListener('click', function(e) {
            if (e.target.id === 'paymentModal') {
                closePaymentModal();
            }
        });
    </script>
</body>
</html>