<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Kamar - KostPro User</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="user-bg">
    <style>
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-gold-light {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
        }
        .glossy-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);
        }
        .user-bg {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fde68a 70%, #fbbf24 100%);
            min-height: 100vh;
        }
        .text-gold {
            color: #92400e;
        }
        .text-gold-dark {
            color: #78350f;
        }
    </style>
    <%- include('../partials/user-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h1 class="text-3xl font-bold text-gold-dark">Multi Booking Kamar</h1>
                <p class="text-gold mt-2">Booking satu atau beberapa kamar sekaligus</p>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="glossy-gold-light border border-amber-200 text-green-700 px-4 py-3 rounded-xl mb-6 glossy-card">
                <i class="fas fa-check-circle mr-2"></i><%= success %>
            </div>
        <% } %>

        <!-- Booking Form -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div class="glossy-white rounded-2xl p-6 glossy-card">
                    <h2 class="text-xl font-bold text-gold-dark mb-6">Pilih Kamar</h2>
                    
                    <form id="multiBookingForm" action="/user/multi-booking" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <div>
                                <label class="block text-sm font-medium text-gold-dark mb-2">Tanggal Mulai</label>
                                <input type="date" name="start_date" required 
                                       class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gold-dark mb-2">Durasi (Bulan)</label>
                                <select name="duration_months" id="durationSelect" required 
                                        class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                    <option value="1">1 Bulan</option>
                                    <option value="3">3 Bulan</option>
                                    <option value="6">6 Bulan</option>
                                    <option value="12">12 Bulan</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-6">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="text-lg font-semibold text-gold-dark">Kamar Terpilih</h3>
                                <button type="button" onclick="showRoomSelector()" 
                                        class="glossy-gold-light text-gold-dark px-4 py-2 rounded-lg hover:opacity-90">
                                    <i class="fas fa-plus mr-2"></i>Tambah Kamar
                                </button>
                            </div>
                            
                            <div id="selectedRoomsContainer" class="space-y-3 mb-4">
                                <% if (selectedRoom && rooms.length > 0) { %>
                                    <% rooms.slice(0, 1).forEach(room => { %>
                                        <div class="border border-green-200 bg-green-50 rounded-lg p-4 selected-room-card">
                                            <div class="flex items-center justify-between">
                                                <div>
                                                    <h4 class="font-semibold text-gold-dark">Kamar <%= room.room_number %></h4>
                                                    <p class="text-sm text-gold"><%= room.type_name %></p>
                                                    <span class="text-xs text-green-600"><i class="fas fa-check mr-1"></i>Terpilih</span>
                                                </div>
                                                <div class="text-right">
                                                    <div class="text-lg font-bold text-amber-600">
                                                        Rp <%= parseInt(room.base_price).toLocaleString('id-ID') %>
                                                    </div>
                                                    <div class="text-xs text-gold">per bulan</div>
                                                </div>
                                            </div>
                                            <input type="checkbox" name="selected_rooms" value="<%= room.id %>" 
                                                   data-price="<%= room.base_price %>" 
                                                   data-room-number="<%= room.room_number %>"
                                                   data-type-name="<%= room.type_name %>"
                                                   data-room-type-id="<%= room.room_type_id %>"
                                                   class="room-checkbox" checked style="display: none;">
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p class="text-gold text-center py-4">Belum ada kamar dipilih. Klik "Tambah Kamar" untuk memilih.</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gold-dark mb-2">Catatan (Opsional)</label>
                            <textarea name="notes" rows="3" 
                                      class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500"
                                      placeholder="Tambahkan catatan khusus..."></textarea>
                        </div>

                        <input type="hidden" name="total_amount" id="totalAmount">
                        <input type="hidden" name="rooms" id="roomsData">
                    </form>
                </div>
            </div>

            <!-- Summary -->
            <div class="lg:col-span-1">
                <div class="glossy-white rounded-2xl p-6 glossy-card sticky top-8">
                    <h3 class="text-lg font-bold text-gold-dark mb-4">Ringkasan Booking</h3>
                    
                    <div id="selectedRoomsList" class="mb-4">
                        <p class="text-gold text-sm">Belum ada kamar dipilih</p>
                    </div>
                    
                    <div class="border-t border-amber-200 pt-4">
                        <div class="flex justify-between mb-2">
                            <span class="text-gold">Durasi:</span>
                            <span id="durationDisplay" class="text-gold-dark">1 bulan</span>
                        </div>
                        <div class="flex justify-between mb-2">
                            <span class="text-gold">Subtotal:</span>
                            <span id="subtotalDisplay" class="text-gold-dark">Rp 0</span>
                        </div>
                        <div class="flex justify-between text-lg font-bold border-t border-amber-200 pt-2">
                            <span class="text-gold-dark">Total:</span>
                            <span id="totalDisplay" class="text-amber-600">Rp 0</span>
                        </div>
                    </div>
                    
                    <button type="submit" form="multiBookingForm" id="bookingButton" 
                            class="w-full glossy-gold text-white px-6 py-3 rounded-lg mt-6">
                        <i class="fas fa-credit-card mr-2"></i>Booking & Lanjut ke Pembayaran
                    </button>
                </div>
            </div>
        </div>

        <!-- Booking History -->
        <div class="mt-12">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-gold-dark mb-6">Riwayat Booking</h2>
                
                <% if (bookings.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="glossy-gold-light">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Tanggal</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Kamar</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Durasi</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Total</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Status</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gold uppercase">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-amber-200">
                                <% bookings.forEach(booking => { %>
                                    <tr class="hover:bg-amber-50">
                                        <td class="px-4 py-3 text-sm text-gold-dark">
                                            <%= new Date(booking.created_at).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gold-dark">
                                            <%= booking.room_numbers || 'Multiple rooms' %>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gold-dark">
                                            <%= booking.duration_months %> bulan
                                        </td>
                                        <td class="px-4 py-3 text-sm font-semibold text-amber-600">
                                            Rp <%= parseInt(booking.total_amount).toLocaleString('id-ID') %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                                <%= booking.status %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="flex gap-2">
                                                <a href="/user/bookings/<%= booking.id %>/print" target="_blank" 
                                                   class="glossy-gold-light text-gold-dark px-3 py-1 rounded text-sm">
                                                    <i class="fas fa-print mr-1"></i>Print PDF
                                                </a>
                                                <a href="/user/payments" class="glossy-gold text-white px-3 py-1 rounded text-sm">
                                                    <i class="fas fa-eye mr-1"></i>Lihat Pembayaran
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-8">
                        <i class="fas fa-calendar-times text-4xl text-amber-300 mb-4"></i>
                        <p class="text-gold">Belum ada riwayat booking</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        const durationSelect = document.getElementById('durationSelect');
        const selectedRoomsList = document.getElementById('selectedRoomsList');
        const subtotalDisplay = document.getElementById('subtotalDisplay');
        const totalDisplay = document.getElementById('totalDisplay');
        const durationDisplay = document.getElementById('durationDisplay');
        const totalAmountInput = document.getElementById('totalAmount');
        const roomsDataInput = document.getElementById('roomsData');

        function updateSummary() {
            const roomCheckboxes = document.querySelectorAll('.room-checkbox:checked');
            const selectedRooms = Array.from(roomCheckboxes);
            const duration = parseInt(durationSelect.value) || 1;
            
            console.log('Updating summary with', selectedRooms.length, 'rooms');
            
            if (selectedRooms.length === 0) {
                selectedRoomsList.innerHTML = '<p class="text-gold text-sm">Belum ada kamar dipilih</p>';
                subtotalDisplay.textContent = 'Rp 0';
                totalDisplay.textContent = 'Rp 0';
                totalAmountInput.value = '0';
                roomsDataInput.value = '[]';
                return;
            }

            let html = '<div class="space-y-2">';
            let subtotal = 0;
            const roomsData = [];

            selectedRooms.forEach(checkbox => {
                const price = parseInt(checkbox.dataset.price) || 0;
                const roomNumber = checkbox.dataset.roomNumber || 'Unknown';
                const typeName = checkbox.dataset.typeName || 'Unknown';
                const roomTypeId = parseInt(checkbox.dataset.roomTypeId) || 0;
                
                subtotal += price;
                roomsData.push({
                    room_id: parseInt(checkbox.value),
                    room_type_id: roomTypeId,
                    room_number: roomNumber,
                    type_name: typeName,
                    price: price,
                    subtotal: price * duration
                });

                html += `
                    <div class="flex justify-between text-sm">
                        <span class="text-gold">Kamar ${roomNumber} (${typeName})</span>
                        <span class="text-gold-dark">Rp ${price.toLocaleString('id-ID')}</span>
                    </div>
                `;
            });
            html += '</div>';

            const total = subtotal * duration;

            selectedRoomsList.innerHTML = html;
            subtotalDisplay.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
            totalDisplay.textContent = `Rp ${total.toLocaleString('id-ID')}`;
            durationDisplay.textContent = `${duration} bulan`;
            
            totalAmountInput.value = total;
            roomsDataInput.value = JSON.stringify(roomsData);
            
            console.log('Updated form data:', {
                total_amount: total,
                rooms_data: roomsData
            });
        }

        function showRoomSelector() {
            document.getElementById('roomModal').classList.remove('hidden');
            loadAvailableRooms();
        }
        
        function closeRoomModal() {
            document.getElementById('roomModal').classList.add('hidden');
        }
        
        function loadAvailableRooms() {
            fetch('/user/api/available-rooms')
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('availableRooms');
                    container.innerHTML = '';
                    
                    data.rooms.forEach(room => {
                        const roomCard = `
                            <div class="border border-amber-200 rounded-lg p-4">
                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <h4 class="font-semibold text-gold-dark">Kamar ${room.room_number}</h4>
                                        <p class="text-sm text-gold">${room.type_name}</p>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-lg font-bold text-amber-600">
                                            Rp ${parseInt(room.base_price).toLocaleString('id-ID')}
                                        </div>
                                        <div class="text-xs text-gold">per bulan</div>
                                    </div>
                                </div>
                                <button onclick="addRoom(${room.id}, '${room.room_number}', '${room.type_name}', ${room.base_price}, ${room.room_type_id})" 
                                        class="w-full glossy-gold text-white px-4 py-2 rounded-lg hover:opacity-90">
                                    <i class="fas fa-plus mr-2"></i>Tambah Kamar
                                </button>
                            </div>
                        `;
                        container.innerHTML += roomCard;
                    });
                })
                .catch(error => {
                    console.error('Error loading rooms:', error);
                });
        }
        
        function addRoom(roomId, roomNumber, typeName, price, roomTypeId) {
            const container = document.getElementById('selectedRoomsContainer');
            
            // Check if room already selected
            const existing = container.querySelector(`input[value="${roomId}"]`);
            if (existing) {
                alert('Kamar sudah dipilih!');
                return;
            }
            
            const roomCard = `
                <div class="border border-green-200 bg-green-50 rounded-lg p-4 selected-room-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <h4 class="font-semibold text-gold-dark">Kamar ${roomNumber}</h4>
                            <p class="text-sm text-gold">${typeName}</p>
                            <span class="text-xs text-green-600"><i class="fas fa-check mr-1"></i>Terpilih</span>
                        </div>
                        <div class="text-right">
                            <div class="text-lg font-bold text-amber-600">
                                Rp ${parseInt(price).toLocaleString('id-ID')}
                            </div>
                            <div class="text-xs text-gold">per bulan</div>
                            <button onclick="removeRoom(this)" class="text-red-500 hover:text-red-700 text-xs mt-1">
                                <i class="fas fa-times mr-1"></i>Hapus
                            </button>
                        </div>
                    </div>
                    <input type="checkbox" name="selected_rooms" value="${roomId}" 
                           data-price="${price}" 
                           data-room-number="${roomNumber}"
                           data-type-name="${typeName}"
                           data-room-type-id="${roomTypeId}"
                           class="room-checkbox" checked style="display: none;">
                </div>
            `;
            
            // Remove "no rooms selected" message if exists
            const noRoomsMsg = container.querySelector('p');
            if (noRoomsMsg && noRoomsMsg.textContent.includes('Belum ada kamar')) {
                noRoomsMsg.remove();
            }
            
            container.innerHTML += roomCard;
            updateSummary();
            closeRoomModal();
        }
        
        function removeRoom(button) {
            const roomCard = button.closest('.selected-room-card');
            roomCard.remove();
            
            // Show "no rooms selected" message if no rooms left
            const container = document.getElementById('selectedRoomsContainer');
            if (container.children.length === 0) {
                container.innerHTML = '<p class="text-gold text-center py-4">Belum ada kamar dipilih. Klik "Tambah Kamar" untuk memilih.</p>';
            }
            
            updateSummary();
        }

        durationSelect.addEventListener('change', updateSummary);
        
        // Form validation before submit
        document.getElementById('multiBookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const roomCheckboxes = document.querySelectorAll('.room-checkbox:checked');
            const startDate = document.querySelector('input[name="start_date"]').value;
            const duration = document.querySelector('select[name="duration_months"]').value;
            
            console.log('Form validation:', {
                roomsCount: roomCheckboxes.length,
                startDate: startDate,
                duration: duration
            });
            
            if (roomCheckboxes.length === 0) {
                alert('Silakan pilih minimal satu kamar dengan klik "Tambah Kamar"!');
                return false;
            }
            
            if (!startDate) {
                alert('Silakan pilih tanggal mulai!');
                return false;
            }
            
            if (!duration) {
                alert('Silakan pilih durasi!');
                return false;
            }
            
            updateSummary();
            
            const roomsData = document.getElementById('roomsData').value;
            const totalAmount = document.getElementById('totalAmount').value;
            
            if (!roomsData || roomsData === '[]' || !totalAmount || totalAmount === '0') {
                alert('Data booking tidak valid. Silakan pilih kamar terlebih dahulu.');
                return false;
            }
            
            console.log('Submitting form:', {
                rooms: roomsData,
                total_amount: totalAmount,
                start_date: startDate,
                duration_months: duration
            });
            
            const submitBtn = document.getElementById('bookingButton');
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Memproses...';
            submitBtn.disabled = true;
            
            this.submit();
        });
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateSummary();
            
            // Set default date to today
            const today = new Date().toISOString().split('T')[0];
            document.querySelector('input[name="start_date"]').value = today;
        });
        
        // Update immediately
        updateSummary();
    </script>

    <!-- Room Selector Modal -->
    <div id="roomModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="glossy-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                <div class="p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-2xl font-bold text-gold-dark">Pilih Kamar Tambahan</h2>
                        <button onclick="closeRoomModal()" class="text-gold hover:text-gold-dark">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="availableRooms">
                        <div class="col-span-full text-center py-8">
                            <i class="fas fa-spinner fa-spin text-2xl text-amber-500"></i>
                            <p class="mt-2 text-gold">Memuat kamar tersedia...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>