<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Pengaduan - KostPro Admin</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/admin-nav') %>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Kelola Pengaduan</h1>
            <p class="text-gray-600 mt-2">Tangani pengaduan dan keluhan dari penghuni</p>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                <%= success %>
            </div>
        <% } %>

        <!-- Complaints Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm">Total Pengaduan</p>
                        <h3 class="text-2xl font-bold"><%= complaints.length %></h3>
                    </div>
                    <i class="fas fa-clipboard-list text-3xl text-blue-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-100 text-sm">Baru</p>
                        <h3 class="text-2xl font-bold">
                            <%= complaints.filter(c => c.status === 'open').length %>
                        </h3>
                    </div>
                    <i class="fas fa-exclamation-circle text-3xl text-yellow-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-orange-500 to-orange-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-orange-100 text-sm">Diproses</p>
                        <h3 class="text-2xl font-bold">
                            <%= complaints.filter(c => c.status === 'in_progress').length %>
                        </h3>
                    </div>
                    <i class="fas fa-cog text-3xl text-orange-200"></i>
                </div>
            </div>

            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">Selesai</p>
                        <h3 class="text-2xl font-bold">
                            <%= complaints.filter(c => c.status === 'resolved').length %>
                        </h3>
                    </div>
                    <i class="fas fa-check-circle text-3xl text-green-200"></i>
                </div>
            </div>
        </div>

        <!-- Complaints List -->
        <div class="bg-white rounded-xl shadow-sm">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-xl font-bold text-gray-800">Daftar Pengaduan</h2>
            </div>
            
            <div class="p-6">
                <% if (complaints.length > 0) { %>
                    <div class="space-y-6">
                        <% complaints.forEach(complaint => { %>
                            <div class="border border-gray-200 rounded-lg p-6">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex-1">
                                        <div class="flex items-center space-x-4 mb-2">
                                            <h3 class="text-lg font-semibold text-gray-800"><%= complaint.title %></h3>
                                            <% if (complaint.priority === 'high') { %>
                                                <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">
                                                    <i class="fas fa-exclamation-triangle mr-1"></i>Tinggi
                                                </span>
                                            <% } else if (complaint.priority === 'medium') { %>
                                                <span class="bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full">
                                                    <i class="fas fa-exclamation-circle mr-1"></i>Sedang
                                                </span>
                                            <% } else { %>
                                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">
                                                    <i class="fas fa-info-circle mr-1"></i>Rendah
                                                </span>
                                            <% } %>
                                        </div>
                                        
                                        <div class="flex items-center space-x-6 text-sm text-gray-600 mb-3">
                                            <div class="flex items-center">
                                                <i class="fas fa-user mr-2"></i>
                                                <span><%= complaint.user_name %></span>
                                            </div>
                                            <% if (complaint.phone) { %>
                                                <div class="flex items-center">
                                                    <i class="fas fa-phone mr-2"></i>
                                                    <span><%= complaint.phone %></span>
                                                </div>
                                            <% } %>
                                            <% if (complaint.room_number) { %>
                                                <div class="flex items-center">
                                                    <i class="fas fa-door-open mr-2"></i>
                                                    <span>Kamar <%= complaint.room_number %></span>
                                                </div>
                                            <% } %>
                                            <div class="flex items-center">
                                                <i class="fas fa-calendar mr-2"></i>
                                                <span><%= new Date(complaint.created_at).toLocaleDateString('id-ID') %></span>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center space-x-4 text-sm text-gray-600 mb-3">
                                            <span><i class="fas fa-tag mr-1"></i><%= complaint.category %></span>
                                            <% if (complaint.facility_type) { %>
                                                <span><i class="fas fa-wrench mr-1"></i><%= complaint.facility_type %></span>
                                            <% } %>
                                            <% if (complaint.room_type) { %>
                                                <span><i class="fas fa-bed mr-1"></i><%= complaint.room_type %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="flex items-center space-x-2">
                                        <% if (complaint.status === 'open') { %>
                                            <span class="bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full">
                                                <i class="fas fa-clock mr-1"></i>Baru
                                            </span>
                                        <% } else if (complaint.status === 'in_progress') { %>
                                            <span class="bg-yellow-100 text-yellow-800 text-xs px-3 py-1 rounded-full">
                                                <i class="fas fa-cog mr-1"></i>Diproses
                                            </span>
                                        <% } else if (complaint.status === 'resolved') { %>
                                            <span class="bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full">
                                                <i class="fas fa-check mr-1"></i>Selesai
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                                
                                <p class="text-gray-700 mb-4"><%= complaint.description %></p>
                                
                                <% if (complaint.admin_response) { %>
                                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
                                        <h4 class="font-semibold text-green-800 mb-2">
                                            <i class="fas fa-reply mr-1"></i>Tanggapan Admin:
                                        </h4>
                                        <p class="text-green-700"><%= complaint.admin_response %></p>
                                    </div>
                                <% } %>
                                
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                        <% if (complaint.status !== 'resolved') { %>
                                            <button onclick="updateComplaintStatus('<%= complaint.id %>', 'in_progress')" 
                                                    class="text-yellow-600 hover:text-yellow-800 text-sm">
                                                <i class="fas fa-play mr-1"></i>Proses
                                            </button>
                                            <button onclick="updateComplaintStatus('<%= complaint.id %>', 'resolved')" 
                                                    class="text-green-600 hover:text-green-800 text-sm">
                                                <i class="fas fa-check mr-1"></i>Selesai
                                            </button>
                                        <% } %>
                                        <button onclick="openResponseModal('<%= complaint.id %>', '<%= complaint.title %>', '<%= complaint.admin_response || '' %>')" 
                                                class="text-blue-600 hover:text-blue-800 text-sm">
                                            <i class="fas fa-reply mr-1"></i>Tanggapi
                                        </button>
                                    </div>
                                    
                                    <button onclick="sendNotification('<%= complaint.user_id %>', '<%= complaint.user_name %>')" 
                                            class="text-purple-600 hover:text-purple-800 text-sm">
                                        <i class="fas fa-bell mr-1"></i>Kirim Notifikasi
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-clipboard-list text-4xl text-gray-400 mb-4"></i>
                        <h3 class="text-lg font-semibold text-gray-600 mb-2">Belum Ada Pengaduan</h3>
                        <p class="text-gray-500">Pengaduan dari penghuni akan muncul di sini</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Response Modal -->
    <div id="responseModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
            <form action="/admin/complaints/response" method="POST">
                <div class="p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Tanggapi Pengaduan</h3>
                    <input type="hidden" name="complaint_id" id="complaint_id">
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Judul Pengaduan</label>
                            <input type="text" id="complaint_title" readonly 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-50">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggapan</label>
                            <textarea name="admin_response" id="admin_response" rows="4" required 
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                      placeholder="Berikan tanggapan untuk pengaduan ini..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-6 py-4 rounded-b-lg flex justify-end space-x-3">
                    <button type="button" onclick="closeResponseModal()" 
                            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        <i class="fas fa-reply mr-2"></i>Kirim Tanggapan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Modal -->
    <div id="notificationModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
            <form action="/admin/notifications" method="POST" id="notificationForm">
                <div class="p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Kirim Notifikasi</h3>
                    <input type="hidden" name="user_id" id="notification_user_id">
                    <input type="hidden" name="redirect" value="complaints">
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Kepada</label>
                            <input type="text" id="notification_user_name" readonly 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-50">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Judul</label>
                            <input type="text" name="title" required 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                   placeholder="Judul notifikasi">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Pesan</label>
                            <textarea name="message" rows="3" required 
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                      placeholder="Isi pesan notifikasi..."></textarea>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tipe</label>
                            <select name="type" required 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="info">Info</option>
                                <option value="warning">Peringatan</option>
                                <option value="success">Sukses</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-6 py-4 rounded-b-lg flex justify-end space-x-3">
                    <button type="button" onclick="closeNotificationModal()" 
                            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                        Batal
                    </button>
                    <button type="submit" 
                            class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                        <i class="fas fa-bell mr-2"></i>Kirim Notifikasi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateComplaintStatus(complaintId, status) {
            fetch(`/admin/complaints/${complaintId}/status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ status: status })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Gagal mengupdate status');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Terjadi kesalahan');
            });
        }

        function openResponseModal(complaintId, title, currentResponse) {
            document.getElementById('complaint_id').value = complaintId;
            document.getElementById('complaint_title').value = title;
            document.getElementById('admin_response').value = currentResponse;
            
            document.getElementById('responseModal').classList.remove('hidden');
            document.getElementById('responseModal').classList.add('flex');
        }

        function closeResponseModal() {
            document.getElementById('responseModal').classList.add('hidden');
            document.getElementById('responseModal').classList.remove('flex');
        }

        function sendNotification(userId, userName) {
            document.getElementById('notification_user_id').value = userId;
            document.getElementById('notification_user_name').value = userName;
            
            document.getElementById('notificationModal').classList.remove('hidden');
            document.getElementById('notificationModal').classList.add('flex');
        }

        function closeNotificationModal() {
            document.getElementById('notificationModal').classList.add('hidden');
            document.getElementById('notificationModal').classList.remove('flex');
        }

        // Close modals when clicking outside
        document.getElementById('responseModal').addEventListener('click', function(e) {
            if (e.target.id === 'responseModal') {
                closeResponseModal();
            }
        });

        document.getElementById('notificationModal').addEventListener('click', function(e) {
            if (e.target.id === 'notificationModal') {
                closeNotificationModal();
            }
        });
    </script>
</body>
</html>