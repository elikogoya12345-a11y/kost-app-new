<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kos Putra Bu Hartini - Tempat Tinggal Nyaman Dekat UMN</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* GUEST COLOR SCHEME: White Glossy Dominant */
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 32px rgba(255, 255, 255, 0.4), 0 2px 8px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        /* Blue Glossy - Secondary Accent */
        .glossy-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3), 0 2px 8px rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        /* Gold Glossy - Small Accent */
        .glossy-gold {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 32px rgba(245, 158, 11, 0.3), 0 2px 8px rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .glossy-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
        }
        
        .glossy-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        /* Guest Background */
        .guest-bg {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 50%, #e2e8f0 100%);
        }
        
        /* Modern Badge */
        .badge-gold {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
        }
    </style>
</head>
<body class="guest-bg">
    <!-- Navigation -->
    <nav class="glossy-white sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-home text-2xl text-amber-600"></i>
                    <span class="text-xl font-bold text-gray-800">Kos Putra Bu Hartini</span>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <!-- User sudah login -->
                        <% if (user.role === 'admin') { %>
                            <a href="/admin/dashboard" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard Admin
                            </a>
                        <% } else { %>
                            <a href="/user/dashboard" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard User
                            </a>
                        <% } %>
                        <div class="flex items-center space-x-2 text-gray-600">
                            <i class="fas fa-user-circle"></i>
                            <span>Halo, <%= user.name %>!</span>
                        </div>
                        <a href="/auth/logout" class="text-gray-600 hover:text-red-600 transition">
                            <i class="fas fa-sign-out-alt mr-2"></i>Logout
                        </a>
                    <% } else { %>
                        <!-- User belum login -->
                        <a href="/auth/login" class="glossy-blue text-white px-4 py-2 rounded-lg glossy-card">
                            <i class="fas fa-sign-in-alt mr-2"></i>Login
                        </a>
                        <a href="/auth/register" class="glossy-gold text-white px-4 py-2 rounded-lg glossy-card">
                            <i class="fas fa-user-plus mr-2"></i>Daftar
                        </a>
                        <a href="/about" class="text-gray-600 hover:text-blue-600 transition px-3 py-2 rounded-lg hover:bg-blue-50">
                            <i class="fas fa-info-circle mr-2"></i>Tentang Kami
                        </a>
                        <a href="/guest/dashboard" class="text-blue-600 hover:text-blue-700 transition px-3 py-2 rounded-lg hover:bg-blue-50">
                            <i class="fas fa-eye mr-2"></i>Masuk Sebagai Tamu
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <% if (user && user.role === 'admin') { %>
        <!-- Admin Hero: Blue Glossy -->
        <section class="glossy-blue text-white py-20">
    <% } else if (user && user.role === 'user') { %>
        <!-- User Hero: Gold Glossy -->
        <section class="glossy-gold text-white py-20">
    <% } else { %>
        <!-- Guest Hero: White Glossy with Blue accent -->
        <section class="glossy-white text-gray-800 py-20">
    <% } %>
        <div class="max-w-7xl mx-auto px-4 text-center">
            <% if (user) { %>
                <!-- Hero untuk user yang sudah login -->
                <h1 class="text-5xl font-bold mb-6">Selamat Datang Kembali!</h1>
                <p class="text-xl mb-8 opacity-90">Halo <%= user.name %>, akses dashboard Anda untuk mengelola kost</p>
                <div class="flex justify-center space-x-4">
                    <% if (user.role === 'admin') { %>
                        <a href="/admin/dashboard" class="glossy-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:scale-105 transition glossy-card">
                            <i class="fas fa-tachometer-alt mr-2"></i>Dashboard Admin
                        </a>
                        <a href="/admin/occupants" class="glossy-gold text-white px-8 py-3 rounded-lg font-semibold hover:scale-105 transition glossy-card">
                            <i class="fas fa-users mr-2"></i>Kelola Penghuni
                        </a>
                    <% } else { %>
                        <a href="/user/dashboard" class="glossy-white text-amber-600 px-8 py-3 rounded-lg font-semibold hover:scale-105 transition glossy-card">
                            <i class="fas fa-tachometer-alt mr-2"></i>Dashboard User
                        </a>
                        <a href="/user/rooms" class="glossy-blue text-white px-8 py-3 rounded-lg font-semibold hover:scale-105 transition glossy-card">
                            <i class="fas fa-bed mr-2"></i>Lihat Kamar
                        </a>
                    <% } %>
                </div>
            <% } else { %>
                <!-- Hero untuk guest -->
                <div class="flex items-center justify-center mb-4">
                    <span class="badge-gold mr-3">✨ PREMIUM</span>
                    <span class="text-blue-600 font-medium">Dekat UMN</span>
                </div>
                <h1 class="text-5xl font-bold mb-6 text-gray-800">Kos Putra Bu Hartini</h1>
                <p class="text-xl mb-8 text-gray-600 max-w-2xl mx-auto">Tempat tinggal nyaman dengan fasilitas lengkap dan harga terjangkau. Lokasi strategis dekat kampus.</p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/auth/register" class="glossy-gold text-white px-8 py-4 rounded-xl font-semibold glossy-card flex items-center justify-center">
                        <i class="fas fa-rocket mr-2"></i>Mulai Sekarang
                    </a>
                    <a href="#facilities" class="glossy-blue text-white px-8 py-4 rounded-xl font-semibold glossy-card flex items-center justify-center">
                        <i class="fas fa-eye mr-2"></i>Lihat Fasilitas
                    </a>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Quick Access untuk User yang Login -->
    <% if (user) { %>
    <section class="py-12" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Akses Cepat</h2>
                <p class="text-gray-600">Navigasi cepat ke fitur utama</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <% if (user.role === 'admin') { %>
                    <!-- Admin: Blue dominant, Gold accent, White base -->
                    <a href="/admin/dashboard" class="glossy-blue text-white p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-chart-line text-3xl mb-3"></i>
                        <h3 class="font-semibold">Dashboard</h3>
                        <p class="text-sm opacity-90">Statistik & Laporan</p>
                    </a>
                    <a href="/admin/occupants" class="glossy-white text-blue-600 p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-users text-3xl mb-3"></i>
                        <h3 class="font-semibold">Penghuni</h3>
                        <p class="text-sm opacity-75">Kelola Penghuni</p>
                    </a>
                    <a href="/admin/rooms" class="glossy-gold text-white p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-bed text-3xl mb-3"></i>
                        <h3 class="font-semibold">Kamar</h3>
                        <p class="text-sm opacity-90">Kelola Kamar</p>
                    </a>
                    <a href="/admin/complaints" class="glossy-blue text-white p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-exclamation-triangle text-3xl mb-3"></i>
                        <h3 class="font-semibold">Pengaduan</h3>
                        <p class="text-sm opacity-90">Tangani Keluhan</p>
                    </a>
                <% } else { %>
                    <!-- User: Gold dominant, White base, Blue accent -->
                    <a href="/user/dashboard" class="glossy-gold text-white p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-tachometer-alt text-3xl mb-3"></i>
                        <h3 class="font-semibold">Dashboard</h3>
                        <p class="text-sm opacity-90">Panel Utama</p>
                    </a>
                    <a href="/user/rooms" class="glossy-white text-amber-600 p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-bed text-3xl mb-3"></i>
                        <h3 class="font-semibold">Kamar</h3>
                        <p class="text-sm opacity-75">Lihat & Booking</p>
                    </a>
                    <a href="/user/payments" class="glossy-white text-amber-600 p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-credit-card text-3xl mb-3"></i>
                        <h3 class="font-semibold">Pembayaran</h3>
                        <p class="text-sm opacity-75">Riwayat Bayar</p>
                    </a>
                    <a href="/user/complaints" class="glossy-gold text-white p-6 rounded-xl glossy-card text-center">
                        <i class="fas fa-exclamation-triangle text-3xl mb-3"></i>
                        <h3 class="font-semibold">Pengaduan</h3>
                        <p class="text-sm opacity-90">Laporkan Masalah</p>
                    </a>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Room Types Info (No Images) -->
    <% if (!user) { %>
    <section class="py-20 guest-bg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center">
                <div class="glossy-white rounded-2xl p-12 glossy-card">
                    <div class="flex items-center justify-center mb-6">
                        <span class="badge-gold mr-3">🏠 KAMAR</span>
                    </div>
                    <h2 class="text-4xl font-bold text-gray-800 mb-4">7 Tipe Kamar Tersedia</h2>
                    <p class="text-xl text-gray-600 mb-8">Kami menyediakan 7 tipe kamar dengan berbagai fasilitas dan harga yang sesuai dengan kebutuhan Anda</p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <a href="/guest/dashboard" class="glossy-gold text-white px-8 py-4 rounded-xl font-semibold glossy-card flex items-center justify-center">
                            <i class="fas fa-eye mr-2"></i>Lihat Kamar Sebagai Tamu
                        </a>
                        <a href="/auth/register" class="glossy-blue text-white px-8 py-4 rounded-xl font-semibold glossy-card flex items-center justify-center">
                            <i class="fas fa-user-plus mr-2"></i>Daftar untuk Booking
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Facilities -->
    <section id="facilities" class="py-20" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <div class="flex items-center justify-center mb-4">
                    <span class="badge-gold mr-3">⭐ FASILITAS</span>
                </div>
                <h2 class="text-4xl font-bold text-gray-800 mb-4">Fasilitas Lengkap</h2>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">Nikmati berbagai fasilitas modern untuk kenyamanan hidup Anda</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-blue w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-wifi text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">WiFi Lancar</h3>
                    <p class="text-gray-600 leading-relaxed">Internet cepat 24/7 untuk belajar dan bekerja</p>
                </div>
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-gold w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-bath text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">10 Kamar Mandi</h3>
                    <p class="text-gray-600 leading-relaxed">Kamar mandi bersih dengan air panas</p>
                </div>
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-blue w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-motorcycle text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">Parkir Aman</h3>
                    <p class="text-gray-600 leading-relaxed">Area parkir luas untuk 30 motor</p>
                </div>
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-gold w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-utensils text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">Dapur Lengkap</h3>
                    <p class="text-gray-600 leading-relaxed">5 dapur dengan kompor dan kulkas</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section class="py-20 guest-bg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <div class="flex items-center justify-center mb-4">
                    <span class="badge-gold mr-3">📞 KONTAK</span>
                </div>
                <h2 class="text-4xl font-bold text-gray-800 mb-4">Hubungi Kami</h2>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">Tim kami siap membantu Anda 24/7</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-gold w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fab fa-whatsapp text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">WhatsApp</h3>
                    <p class="text-gray-600 mb-6 text-lg">+62 812-3456-7890</p>
                    <a href="https://wa.me/6281234567890" class="glossy-gold text-white px-6 py-3 rounded-xl font-semibold glossy-card inline-block">
                        <i class="fab fa-whatsapp mr-2"></i>Chat Sekarang
                    </a>
                </div>
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-blue w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-map-marker-alt text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">Lokasi Strategis</h3>
                    <p class="text-gray-600 text-lg leading-relaxed mb-6">Medang Lestari<br>Dekat Universitas Multimedia Nusantara</p>
                    <a href="https://maps.app.goo.gl/V3aKMZkToatH27kTA?g_st=aw" target="_blank" class="glossy-blue text-white px-6 py-3 rounded-xl font-semibold glossy-card inline-block">
                        <i class="fas fa-map-marked-alt mr-2"></i>Buka di Maps
                    </a>
                </div>
                <div class="glossy-white p-8 rounded-2xl text-center glossy-card">
                    <div class="glossy-blue w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-clock text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">Jam Operasional</h3>
                    <p class="text-gray-600 text-lg leading-relaxed">Senin - Minggu<br>08:00 - 22:00 WIB</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="glossy-white py-12 border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <div class="flex items-center justify-center space-x-3 mb-6">
                <i class="fas fa-home text-3xl text-amber-600"></i>
                <span class="text-2xl font-bold text-gray-800">Kos Putra Bu Hartini</span>
            </div>
            <p class="text-gray-600 text-lg mb-6">Tempat tinggal nyaman dekat UMN dengan fasilitas premium</p>
            <div class="flex justify-center space-x-6 mb-6">
                <a href="/auth/register" class="text-blue-600 hover:text-blue-700 font-medium">Daftar</a>
                <a href="/auth/login" class="text-blue-600 hover:text-blue-700 font-medium">Login</a>
                <a href="#facilities" class="text-blue-600 hover:text-blue-700 font-medium">Fasilitas</a>
            </div>
            <p class="text-gray-500">© 2025 Kos Putra Bu Hartini. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>