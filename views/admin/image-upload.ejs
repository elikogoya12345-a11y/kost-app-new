<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Gambar - KostPro Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="admin-bg">
    <style>
        .glossy-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 50%, #1e40af 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f9fafb 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .admin-bg {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 30%, #bfdbfe 70%, #3b82f6 100%);
            min-height: 100vh;
        }
    </style>
    <%- include('../partials/admin-nav') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="glossy-white rounded-2xl p-8">
            <h1 class="text-3xl font-bold text-blue-900 mb-6">Upload Gambar Kamar</h1>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Upload Room Type Image -->
                <div class="glossy-white rounded-xl p-6 border">
                    <h2 class="text-xl font-bold text-blue-800 mb-4">
                        <i class="fas fa-image mr-2"></i>Gambar Tipe Kamar
                    </h2>
                    <form id="roomTypeForm" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Tipe Kamar</label>
                            <select name="room_type" required class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                                <option value="">Pilih Tipe Kamar</option>
                                <option value="Standard-room">Standard Room</option>
                                <option value="Superior-room">Superior Room</option>
                                <option value="Deluxe-room">Deluxe Room</option>
                                <option value="Suite-room">Suite Room</option>
                                <option value="Share-room">Share Room</option>
                                <option value="Twin-room">Twin Room</option>
                                <option value="Large-room">Large Room</option>
                                <option value="President-room">President Room</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Gambar Tipe Kamar</label>
                            <input type="file" name="image" accept="image/*" required 
                                   class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                            <input type="hidden" name="image_type" value="room_type">
                        </div>
                        <button type="submit" class="glossy-blue text-white px-4 py-2 rounded-lg w-full">
                            <i class="fas fa-upload mr-2"></i>Upload Gambar Tipe
                        </button>
                    </form>
                </div>

                <!-- Upload Available Room Image -->
                <div class="glossy-white rounded-xl p-6 border">
                    <h2 class="text-xl font-bold text-blue-800 mb-4">
                        <i class="fas fa-door-open mr-2"></i>Gambar Kamar Tersedia
                    </h2>
                    <form id="availableRoomForm" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Tipe Kamar</label>
                            <select name="room_type" required class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                                <option value="">Pilih Tipe Kamar</option>
                                <option value="Standard-room">Standard Room</option>
                                <option value="Superior-room">Superior Room</option>
                                <option value="Deluxe-room">Deluxe Room</option>
                                <option value="Suite-room">Suite Room</option>
                                <option value="Share-room">Share Room</option>
                                <option value="Twin-room">Twin Room</option>
                                <option value="Large-room">Large Room</option>
                                <option value="President-room">President Room</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-blue-700 mb-2">Gambar Kamar Tersedia</label>
                            <input type="file" name="image" accept="image/*" required 
                                   class="w-full px-3 py-2 border border-blue-300 rounded-lg">
                            <input type="hidden" name="image_type" value="available_room">
                        </div>
                        <button type="submit" class="glossy-blue text-white px-4 py-2 rounded-lg w-full">
                            <i class="fas fa-upload mr-2"></i>Upload Gambar Tersedia
                        </button>
                    </form>
                </div>
            </div>

            <!-- Current Images Preview -->
            <div class="mt-8">
                <h2 class="text-xl font-bold text-blue-800 mb-4">Preview Gambar Saat Ini</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="imagePreview">
                    <!-- Images will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        // Handle room type form
        document.getElementById('roomTypeForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            
            try {
                const response = await fetch('/upload/image', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Gambar tipe kamar berhasil diupload!');
                    e.target.reset();
                    loadImagePreview();
                } else {
                    alert('Upload gagal: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        // Handle available room form
        document.getElementById('availableRoomForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            
            try {
                const response = await fetch('/upload/image', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Gambar kamar tersedia berhasil diupload!');
                    e.target.reset();
                    loadImagePreview();
                } else {
                    alert('Upload gagal: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        // Load image preview
        function loadImagePreview() {
            const roomTypes = ['Standard-room', 'Superior-room', 'Deluxe-room', 'Suite-room', 
                             'Share-room', 'Twin-room', 'Large-room', 'President-room'];
            
            const previewDiv = document.getElementById('imagePreview');
            previewDiv.innerHTML = '';
            
            roomTypes.forEach(roomType => {
                const div = document.createElement('div');
                div.className = 'text-center';
                div.innerHTML = `
                    <h3 class="text-sm font-medium text-blue-700 mb-2">${roomType.replace('-', ' ')}</h3>
                    <img src="/images/${roomType}/${roomType}.jpg" 
                         alt="${roomType}" 
                         class="w-full h-24 object-cover rounded-lg mb-2"
                         onerror="this.src='https://via.placeholder.com/150x100/3b82f6/ffffff?text=No+Image'">
                    <img src="/images/${roomType}/Kamar Tersedia.jpg" 
                         alt="Available ${roomType}" 
                         class="w-full h-24 object-cover rounded-lg"
                         onerror="this.src='https://via.placeholder.com/150x100/3b82f6/ffffff?text=No+Image'">
                `;
                previewDiv.appendChild(div);
            });
        }

        // Load preview on page load
        loadImagePreview();
    </script>
</body>
</html>