<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Kost Putra Medang</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* ADMIN THEME: Blue Glossy Dominant with Gold Accents */
        .glossy-blue {
            background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 50%, #1d4ed8 100%);
            backdrop-filter: blur(20px);
            box-shadow: 0 12px 40px rgba(30, 64, 175, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-blue-light {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 50%, #93c5fd 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        .glossy-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 35px rgba(251, 191, 36, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .glossy-white {
            background: linear-gradient(135deg, #ffffff 0%, #fefefe 50%, #f8fafc 100%);
            backdrop-filter: blur(15px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glossy-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
        }
        .glossy-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        .admin-bg {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 30%, #bae6fd 70%, #7dd3fc 100%);
            min-height: 100vh;
        }
        .text-blue-dark {
            color: #1e3a8a;
        }
        .text-blue-medium {
            color: #1d4ed8;
        }
        .badge-gold {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(251, 191, 36, 0.4);
        }
    </style>
</head>
<body class="admin-bg">
    <%- include('../partials/admin-nav') %>

    <div class="container mx-auto px-4 py-8 max-w-7xl">
        <div class="mb-8">
            <div class="glossy-blue rounded-2xl p-8 glossy-card">
                <div class="flex items-center space-x-6">
                    <div class="glossy-gold w-20 h-20 rounded-2xl flex items-center justify-center glossy-card">
                        <i class="fas fa-crown text-3xl text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-white mb-2">Admin Control Center</h1>
                        <p class="text-blue-100 text-lg">Selamat datang, <%= user.name %>! Kelola kost dengan kontrol penuh.</p>
                        <div class="flex items-center mt-3 space-x-4">
                            <span class="badge-gold">🏆 PREMIUM ACCESS</span>
                            <span class="text-blue-200 text-sm">Full Administrative Control</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Period Filter -->
        <div class="mb-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="badge-gold">📊 ANALYTICS</span>
                        <label class="text-xl font-bold text-blue-dark">Filter Periode Data</label>
                    </div>
                    <select onchange="window.location.href='/admin/dashboard?period='+this.value" 
                            class="glossy-white text-blue-dark px-6 py-3 rounded-xl focus:ring-2 focus:ring-blue-300 border-0 font-medium glossy-card">
                        <option value="week" <%= period === 'week' ? 'selected' : '' %>>📅 Minggu Ini</option>
                        <option value="month" <%= period === 'month' ? 'selected' : '' %>>📅 Bulan Ini</option>
                        <option value="year" <%= period === 'year' ? 'selected' : '' %>>📅 Tahun Ini</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
            <div class="glossy-blue rounded-2xl p-6 text-white glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm font-medium">Pendapatan</p>
                        <h3 class="text-xl font-bold">
                            Rp <% 
                                const revenue = parseInt(stats.revenue || 0);
                                if (revenue >= 1000000) {
                                    const millions = revenue / 1000000;
                                    if (millions % 1 === 0) {
                            %><%= millions %> Juta<% } else { %><%= millions.toFixed(1) %> Juta<% } 
                                } else if (revenue >= 1000) {
                                    const thousands = revenue / 1000;
                            %><%= thousands %> Ribu<% } else { %><%= revenue %><% } %>
                        </h3>
                        <p class="text-blue-100 text-xs mt-1">
                            <%= period === 'week' ? 'Minggu ini' : period === 'month' ? 'Bulan ini' : 'Tahun ini' %>
                        </p>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-money-bill-wave text-2xl text-blue-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-gold rounded-2xl p-6 text-white glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-amber-100 text-sm font-medium">Total Pendapatan</p>
                        <h3 class="text-xl font-bold">
                            Rp <% 
                                const totalRevenue = parseInt(stats.totalRevenue || 0);
                                if (totalRevenue >= 1000000) {
                                    const millions = totalRevenue / 1000000;
                                    if (millions % 1 === 0) {
                            %><%= millions %> Juta<% } else { %><%= millions.toFixed(1) %> Juta<% } 
                                } else if (totalRevenue >= 1000) {
                                    const thousands = totalRevenue / 1000;
                            %><%= thousands %> Ribu<% } else { %><%= totalRevenue %><% } %>
                        </h3>
                        <p class="text-amber-100 text-xs mt-1">Semua pembayaran</p>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-chart-line text-2xl text-amber-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 text-blue-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-medium text-sm font-medium">Pembayaran Pending</p>
                        <h3 class="text-2xl font-bold text-amber-600"><%= stats.pendingPayments || 0 %></h3>
                        <p class="text-blue-medium text-xs mt-1">Menunggu bayar</p>
                    </div>
                    <div class="glossy-blue-light p-3 rounded-xl glossy-card">
                        <i class="fas fa-clock text-2xl text-amber-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-blue-light rounded-2xl p-6 text-blue-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-medium text-sm font-medium">Kamar Terisi</p>
                        <h3 class="text-2xl font-bold"><%= stats.occupiedRooms || 0 %></h3>
                        <p class="text-blue-medium text-xs mt-1">dari <%= stats.totalRooms || 0 %> kamar</p>
                    </div>
                    <div class="glossy-white p-3 rounded-xl glossy-card">
                        <i class="fas fa-bed text-2xl text-blue-600"></i>
                    </div>
                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 text-blue-dark glossy-card">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-medium text-sm font-medium">Pengaduan</p>
                        <h3 class="text-2xl font-bold text-red-600"><%= stats.unresolvedComplaints || 0 %></h3>
                        <p class="text-blue-medium text-xs mt-1">Belum selesai</p>
                    </div>
                    <div class="glossy-blue-light p-3 rounded-xl glossy-card">
                        <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-blue-dark mb-6">Aksi Cepat</h2>
                <div class="grid grid-cols-2 gap-4">
                    <a href="/admin/occupants" class="flex flex-col items-center p-4 glossy-blue text-white rounded-xl glossy-card">
                        <i class="fas fa-users text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Kelola Penghuni</span>
                    </a>
                    <a href="/admin/rooms" class="flex flex-col items-center p-4 glossy-gold text-white rounded-xl glossy-card">
                        <i class="fas fa-bed text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Kelola Kamar</span>
                    </a>
                    <a href="/admin/payments" class="flex flex-col items-center p-4 glossy-blue-light text-blue-dark rounded-xl glossy-card">
                        <i class="fas fa-credit-card text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Kelola Pembayaran</span>
                    </a>
                    <a href="/admin/complaints" class="flex flex-col items-center p-4 glossy-white text-blue-dark rounded-xl glossy-card border border-red-200">
                        <i class="fas fa-exclamation-triangle text-2xl mb-3 text-red-600"></i>
                        <span class="text-sm font-medium">Pengaduan</span>
                    </a>
                    <a href="/admin/notifications" class="flex flex-col items-center p-4 glossy-gold text-white rounded-xl glossy-card relative">
                        <i class="fas fa-clock text-2xl mb-3"></i>
                        <span class="text-sm font-medium">Pengajuan Perpanjangan</span>
                        <% if (stats.paymentExtensions > 0) { %>
                            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center">
                                <%= stats.paymentExtensions %>
                            </span>
                        <% } %>
                    </a>


                </div>
            </div>

            <div class="glossy-white rounded-2xl p-6 glossy-card">
                <h2 class="text-xl font-bold text-blue-dark mb-6">Kirim Notifikasi</h2>
                <form action="/admin/notifications" method="POST" class="space-y-4">
                    <input type="hidden" name="user_id" value="all">
                    <input type="hidden" name="type" value="info">
                    <div>
                        <label class="block text-sm font-medium text-blue-dark mb-2">Judul</label>
                        <input type="text" name="title" required 
                               class="w-full px-3 py-2 border border-blue-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Judul notifikasi">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-blue-dark mb-2">Pesan</label>
                        <textarea name="message" rows="3" required 
                                  class="w-full px-3 py-2 border border-blue-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  placeholder="Isi pesan notifikasi"></textarea>
                    </div>
                    <button type="submit" 
                            class="w-full glossy-blue text-white py-3 px-4 rounded-xl glossy-card font-medium">
                        <i class="fas fa-bell mr-2"></i>Kirim ke Semua User
                    </button>
                </form>
                <div class="mt-4">
                    <a href="/admin/notifications" class="glossy-gold text-white px-4 py-2 rounded-xl text-sm glossy-card inline-block font-medium">
                        <i class="fas fa-cog mr-2"></i>Kelola Notifikasi Lanjutan
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>

    </script>
</body>
</html>